<div class="page-header-flex" style="margin-bottom: 2rem;">
  <div>
    <h1 style="font-size: 1.5rem; font-weight: 700; color: var(--secondary); margin: 0;">👥 Testimonials & Stories</h1>
    <p style="color: var(--text-muted); margin-top: 0.25rem;">Manage customer reviews, testimonials, and video success stories.</p>
  </div>
  <a href="/admin_custom/testimonials/new" class="btn btn-primary">➕ Add Testimonial</a>
</div>

<div class="card" style="background-color: white; border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-sm);">
  <% if @testimonials.any? %>
    <table class="table" style="margin: 0; width: 100%; border-collapse: collapse; text-align: left;">
      <thead>
        <tr style="background-color: var(--bg-main); border-bottom: 1px solid var(--border);">
          <th style="padding: 1rem;">Customer</th>
          <th style="padding: 1rem;">Rating</th>
          <th style="padding: 1rem;">Product Scope</th>
          <th style="padding: 1rem;">Content</th>
          <th style="padding: 1rem;">Media</th>
          <th style="padding: 1rem;">Status</th>
          <th style="padding: 1rem; text-align: right;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @testimonials.each do |testimonial| %>
          <tr style="border-bottom: 1px solid var(--border);">
            <td style="padding: 1rem; font-weight: 600; color: var(--secondary);">
              <div style="display: flex; align-items: center; gap: 8px;">
                <% if testimonial.image.attached? %>
                  <img src="<%= url_for(testimonial.image) %>" style="width: 32px; height: 32px; border-radius: 50%; object-fit: cover;">
                <% else %>
                  <span style="font-size: 1.5rem;">👤</span>
                <% end %>
                <%= testimonial.author_name %>
              </div>
            </td>
            <td style="padding: 1rem; color: #f59e0b; font-weight: bold; white-space: nowrap;">
              <% testimonial.rating.times do %>★<% end %><% (5 - testimonial.rating).times do %>☆<% end %>
            </td>
            <td style="padding: 1rem; color: var(--text-main); font-size: 0.85rem; font-weight: 500;">
              <%= testimonial.product ? testimonial.product.name : "Global Storefront" %>
            </td>
            <td style="padding: 1rem; color: var(--text-muted); font-size: 0.85rem; max-width: 250px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
              <%= testimonial.content %>
            </td>
            <td style="padding: 1rem; font-size: 0.85rem; color: var(--text-main);">
              <% if testimonial.video_url.present? %>
                🎥 Video
              <% else %>
                Text
              <% end %>
            </td>
            <td style="padding: 1rem;">
              <span class="badge <%= testimonial.active? ? 'badge-success' : 'badge-danger' %>" style="margin-right: 4px;">
                <%= testimonial.active? ? 'Visible' : 'Hidden' %>
              </span>
              <% if testimonial.is_success_story? %>
                <span class="badge badge-info">⭐ Success Story</span>
              <% end %>
            </td>
            <td style="padding: 1rem; text-align: right; white-space: nowrap;">
              <div style="display: flex; gap: 0.5rem; justify-content: flex-end;">
                <a href="/admin_custom/testimonials/<%= testimonial.id %>/edit" class="btn btn-secondary btn-sm">Edit</a>
                <%= button_to admin_custom_testimonial_path(testimonial), method: :delete, class: "btn btn-outline btn-sm", style: "color: var(--danger); border-color: #fee2e2;", data: { confirm: "Are you sure you want to delete this testimonial?" } do %>
                  Delete
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div style="padding: 3rem; text-align: center; color: var(--text-muted);">
      <div style="font-size: 3rem; margin-bottom: 1rem;">👥</div>
      <p style="font-weight: 500;">No testimonials configure yet.</p>
      <a href="/admin_custom/testimonials/new" class="btn btn-primary btn-sm" style="margin-top: 1rem;">Add your first testimonial</a>
    </div>
  <% end %>
</div>
