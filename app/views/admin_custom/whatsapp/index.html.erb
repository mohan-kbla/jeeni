<% content_for :title, "WhatsApp Chats - Admin" %>

<style>
  .chat-layout {
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: 1.5rem;
    height: calc(100vh - 160px);
    min-height: 600px;
  }
  @media (max-width: 992px) {
    .chat-layout {
      grid-template-columns: 1fr;
      height: auto;
    }
  }
  .chat-list-card {
    background: var(--bg-card, #ffffff);
    border: 1px solid var(--border, #e2e8f0);
    border-radius: var(--radius-md, 8px);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow: var(--shadow-sm, 0 1px 3px rgba(0,0,0,0.05));
  }
  .chat-list-header {
    padding: 1rem;
    border-bottom: 1px solid var(--border, #e2e8f0);
    background: var(--bg-main, #f8fafc);
  }
  .chat-list-body {
    flex: 1;
    overflow-y: auto;
  }
  .chat-item {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--border, #f1f5f9);
    cursor: pointer;
    transition: background 0.15s ease;
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .chat-item:hover {
    background: var(--bg-main, #f8fafc);
  }
  .chat-item.active {
    background: #eff6ff;
    border-left: 4px solid var(--primary, #2563eb);
  }
  .chat-main-card {
    background: var(--bg-card, #ffffff);
    border: 1px solid var(--border, #e2e8f0);
    border-radius: var(--radius-md, 8px);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow: var(--shadow-sm, 0 1px 3px rgba(0,0,0,0.05));
  }
  .chat-header {
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--border, #e2e8f0);
    background: var(--bg-main, #f8fafc);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .chat-messages-container {
    flex: 1;
    padding: 1.25rem;
    overflow-y: auto;
    background: #efeae2; /* Authentic WhatsApp web background */
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .msg-bubble {
    max-width: 75%;
    padding: 0.6rem 0.85rem;
    border-radius: 8px;
    font-size: 0.9rem;
    line-height: 1.4;
    position: relative;
    word-break: break-word;
    box-shadow: 0 1px 1px rgba(0,0,0,0.1);
  }
  .msg-incoming {
    align-self: flex-start;
    background: #ffffff;
    color: #111827;
    border-top-left-radius: 0;
  }
  .msg-outgoing {
    align-self: flex-end;
    background: #d9fdd3;
    color: #111827;
    border-top-right-radius: 0;
  }
  .msg-time {
    font-size: 0.7rem;
    color: #6b7280;
    margin-top: 0.25rem;
    text-align: right;
  }
  .state-badge {
    font-size: 0.75rem;
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-weight: 600;
  }
</style>

<div style="margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
  <div>
    <h1 style="font-size: 1.75rem; font-weight: 700; color: var(--secondary);">📱 WhatsApp Bot & Customer Conversations</h1>
    <p style="color: var(--text-muted); font-size: 0.9rem;">View automated WhatsApp booking flows, incoming customer messages, and chat history.</p>
  </div>
</div>

<div class="chat-layout">
  <!-- Left Side: Conversation List -->
  <div class="chat-list-card">
    <div class="chat-list-header">
      <form method="get" action="/admin_custom/whatsapp" style="display: flex; flex-direction: column; gap: 0.5rem;">
        <input type="text" name="query" value="<%= params[:query] %>" placeholder="🔍 Search name or phone..." class="form-control" style="font-size: 0.85rem; padding: 0.4rem 0.6rem;">
        <div style="display: flex; gap: 0.35rem;">
          <%= select_tag :state, options_for_select([['All States', '']] + WhatsappConversation::STATES.map { |s| [s.titleize, s] }, params[:state]), class: "form-control", onchange: "this.form.submit();", style: "font-size: 0.8rem; padding: 0.35rem; width: 100%;" %>
          <button type="submit" class="btn btn-primary btn-sm" style="padding: 0.35rem 0.6rem; font-size: 0.8rem;">Search</button>
        </div>
      </form>
    </div>

    <div class="chat-list-body">
      <% if @conversations.any? %>
        <% @conversations.each do |conv| %>
          <% is_active = @selected_conversation && @selected_conversation.id == conv.id %>
          <a href="/admin_custom/whatsapp?id=<%= conv.id %>&state=<%= params[:state] %>&query=<%= params[:query] %>" class="chat-item <%= 'active' if is_active %>">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.25rem;">
              <strong style="font-size: 0.95rem; color: var(--secondary);"><%= conv.customer_name.presence || "Customer (#{conv.phone_number.to_s.last(4)})" %></strong>
              <small style="font-size: 0.75rem; color: var(--text-muted);"><%= conv.updated_at.strftime("%b %d, %H:%M") %></small>
            </div>
            
            <div style="font-size: 0.85rem; color: #4b5563; margin-bottom: 0.35rem;">
              📞 <%= conv.phone_number %>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center;">
              <% 
                badge_class = case conv.state
                when 'COMPLETED' then 'badge-success'
                when 'CANCELLED' then 'badge-danger'
                when 'CONFIRM_ORDER' then 'badge-info'
                else 'badge-warning'
                end 
              %>
              <span class="badge <%= badge_class %> state-badge"><%= conv.state %></span>
              <% if conv.product_name.present? %>
                <span style="font-size: 0.75rem; color: var(--text-muted); max-width: 140px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= conv.product_name %></span>
              <% end %>
            </div>
          </a>
        <% end %>
      <% else %>
        <div style="padding: 2rem; text-align: center; color: var(--text-muted);">
          No conversations found.
        </div>
      <% end %>
    </div>

    <div style="padding: 0.75rem; border-top: 1px solid var(--border); display: flex; justify-content: center; background: var(--bg-main);">
      <%= paginate @conversations %>
    </div>
  </div>

  <!-- Right Side: Message Thread & Details -->
  <div class="chat-main-card">
    <% if @selected_conversation %>
      <!-- Header Bar -->
      <div class="chat-header">
        <div>
          <h2 style="font-size: 1.1rem; font-weight: 700; margin: 0; color: var(--secondary);">
            <%= @selected_conversation.customer_name.presence || "Customer Phone: #{@selected_conversation.phone_number}" %>
          </h2>
          <span style="font-size: 0.85rem; color: var(--text-muted);">
            WA ID: <strong><%= @selected_conversation.wa_id %></strong> | State: <strong style="color: var(--primary);"><%= @selected_conversation.state %></strong>
          </span>
        </div>

        <div>
          <% if @order %>
            <a href="/admin_custom/orders/<%= @order.number %>" class="btn btn-primary btn-sm" style="font-weight: 600; padding: 0.35rem 0.75rem; font-size: 0.8rem;">
              🛒 View Order #<%= @order.number %> (₹<%= '%.2f' % @order.total %>)
            </a>
          <% else %>
            <span class="badge badge-warning" style="font-size: 0.8rem; padding: 0.35rem 0.5rem;">No Order Placed Yet</span>
          <% end %>
        </div>
      </div>

      <!-- Customer Flow Summary Banner -->
      <div style="background: #f8fafc; padding: 0.85rem 1.25rem; border-bottom: 1px solid var(--border); font-size: 0.85rem; display: flex; flex-wrap: wrap; gap: 1.5rem; line-height: 1.5;">
        <div>
          <span style="color: var(--text-muted);">📦 Product:</span>
          <strong><%= @selected_conversation.product_name.presence || "Not selected" %> <%= "(Qty: #{@selected_conversation.quantity})" if @selected_conversation.quantity.to_i > 1 %></strong>
        </div>
        <div>
          <span style="color: var(--text-muted);">📍 City/Zip:</span>
          <strong><%= [@selected_conversation.city, @selected_conversation.zipcode].compact.join(' - ').presence || "Pending" %></strong>
        </div>
        <% if @selected_conversation.address.present? %>
          <div style="width: 100%;">
            <span style="color: var(--text-muted);">🏠 Delivery Address:</span>
            <strong><%= @selected_conversation.address %></strong>
          </div>
        <% end %>
      </div>

      <!-- Scrollable Message History -->
      <div class="chat-messages-container" id="chatContainer">
        <% if @messages.any? %>
          <% @messages.each do |msg| %>
            <% 
              # Check direction if set, or infer from payload
              direction = if msg.respond_to?(:direction) && msg.direction.present?
                            msg.direction
                          else
                            'incoming'
                          end
              is_outgoing = (direction == 'outgoing')
            %>
            <div class="msg-bubble <%= is_outgoing ? 'msg-outgoing' : 'msg-incoming' %>">
              <div style="font-size: 0.75rem; font-weight: 600; margin-bottom: 0.2rem; color: <%= is_outgoing ? '#065f46' : '#1e40af' %>;">
                <%= is_outgoing ? "🤖 Bot / Agent" : "👤 Customer (#{@selected_conversation.phone_number})" %>
              </div>

              <% if msg.respond_to?(:display_text) && msg.display_text.present? %>
                <%= simple_format(msg.display_text, {}, wrapper_tag: "div") %>
              <% else %>
                <%= msg.payload.presence || "Message ID: #{msg.message_id}" %>
              <% end %>

              <div class="msg-time">
                <%= msg.created_at.in_time_zone.strftime("%b %d, %I:%M %p") %>
              </div>
            </div>
          <% end %>
        <% else %>
          <div style="margin: auto; background: white; padding: 1.5rem; border-radius: 8px; text-align: center; color: var(--text-muted); box-shadow: var(--shadow-sm);">
            No logged message history for this conversation yet.
          </div>
        <% end %>
      </div>

      <script>
        // Auto scroll to bottom of chat container
        const chatContainer = document.getElementById('chatContainer');
        if (chatContainer) {
          chatContainer.scrollTop = chatContainer.scrollHeight;
        }
      </script>
    <% else %>
      <div style="margin: auto; padding: 3rem; text-align: center; color: var(--text-muted);">
        <h3>No Conversation Selected</h3>
        <p>Select a WhatsApp conversation from the left panel to inspect message details.</p>
      </div>
    <% end %>
  </div>
</div>
