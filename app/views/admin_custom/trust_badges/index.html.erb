<div class="page-header-flex" style="margin-bottom: 2rem;">
  <div>
    <h1 style="font-size: 1.5rem; font-weight: 700; color: var(--secondary); margin: 0;">🛡️ Trust Badges Manager</h1>
    <p style="color: var(--text-muted); margin-top: 0.25rem;">Manage the badges displayed near product buy buttons.</p>
  </div>
  <a href="/admin_custom/trust_badges/new" class="btn btn-primary">➕ Add Trust Badge</a>
</div>

<div class="card" style="background-color: white; border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-sm);">
  <% if @badges.any? %>
    <table class="table" style="margin: 0; width: 100%; border-collapse: collapse; text-align: left;">
      <thead>
        <tr style="background-color: var(--bg-main); border-bottom: 1px solid var(--border);">
          <th style="padding: 1rem;">Badge</th>
          <th style="padding: 1rem;">Preset Icon</th>
          <th style="padding: 1rem;">Description</th>
          <th style="padding: 1rem;">Status</th>
          <th style="padding: 1rem; text-align: right;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @badges.each do |badge| %>
          <tr style="border-bottom: 1px solid var(--border);">
            <td style="padding: 1rem; font-weight: 600; color: var(--secondary);">
              <div style="display: flex; align-items: center; gap: 8px;">
                <% if badge.image.attached? %>
                  <img src="<%= url_for(badge.image) %>" style="max-height: 24px; border-radius: 2px;">
                <% end %>
                <%= badge.name %>
              </div>
            </td>
            <td style="padding: 1rem; color: var(--text-main); font-size: 0.9rem;">
              <%= TrustBadge::ICONS[badge.icon] || badge.icon %>
            </td>
            <td style="padding: 1rem; color: var(--text-muted); font-size: 0.85rem; max-width: 300px;">
              <%= badge.description %>
            </td>
            <td style="padding: 1rem;">
              <span class="badge <%= badge.active? ? 'badge-success' : 'badge-danger' %>">
                <%= badge.active? ? 'Active' : 'Inactive' %>
              </span>
            </td>
            <td style="padding: 1rem; text-align: right; white-space: nowrap;">
              <div style="display: flex; gap: 0.5rem; justify-content: flex-end;">
                <a href="/admin_custom/trust_badges/<%= badge.id %>/edit" class="btn btn-secondary btn-sm">Edit</a>
                <%= button_to admin_custom_trust_badge_path(badge), method: :delete, class: "btn btn-outline btn-sm", style: "color: var(--danger); border-color: #fee2e2;", data: { confirm: "Are you sure you want to delete this trust badge?" } do %>
                  Delete
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div style="padding: 3rem; text-align: center; color: var(--text-muted);">
      <div style="font-size: 3rem; margin-bottom: 1rem;">🛡️</div>
      <p style="font-weight: 500;">No Trust Badges configured yet.</p>
      <a href="/admin_custom/trust_badges/new" class="btn btn-primary btn-sm" style="margin-top: 1rem;">Add your first badge</a>
    </div>
  <% end %>
</div>
