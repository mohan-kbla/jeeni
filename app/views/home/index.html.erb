  <!-- FEATURE 4 (cont.): Explore More Healthy Products Section -->
  <section class="home-section-other-products" style="margin-bottom: 4rem;">
    <div class="section-title-wrap">
      <h2 class="section-title-main">🌾 Explore More Healthy Millet Products</h2>
      <p class="section-title-sub">Discover our full range of daily wellness and traditional mixes</p>
    </div>
    
    <div class="grid grid-cols-4">
      <% if @other_products.present? && @other_products.any? %>
        <% @other_products.each do |product| %>
          <div class="card">
            <div class="card-img-wrapper" style="position: relative; overflow: hidden; background: #f1f5f9; height: 220px;">
              <%= render_product_media(product) %>
            </div>
            <div class="card-content">
              <span class="cert-badge">Free Delivery</span>
              <h3 class="card-title"><a href="/products/<%= product.slug %>"><%= product.name %></a></h3>
              <p class="card-description"><%= truncate(product.description, length: 75) %></p>
              <div class="card-footer" style="display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; width: 100%; box-sizing: border-box;">
                <% if karnataka_visitor? && product.karnataka_price.present? %>
                  <div style="display: flex; flex-direction: column;">
                    <span class="card-price" style="flex-shrink: 0; font-weight: 800; color: #16a34a; font-size: 1.1rem; line-height: 1.1;">₹<%= product.karnataka_price.to_i %></span>
                    <span style="font-size: 0.75rem; color: #94a3b8; text-decoration: line-through; line-height: 1.1;">₹<%= product.price.to_i %></span>
                  </div>
                <% else %>
                  <span class="card-price" style="flex-shrink: 0; font-weight: 800; color: #0f172a;"><%= product.display_price.to_s %></span>
                <% end %>
                <%= form_tag add_to_cart_path, method: :post, style: "margin: 0; display: inline-block;" do %>
                  <%= hidden_field_tag :variant_id, product.master.id %>
                  <%= hidden_field_tag :quantity, 1 %>
                  <%= hidden_field_tag :checkout, 1 %>
                  <%= submit_tag "⚡ Easy Booking", class: "btn btn-primary btn-sm", style: "border-radius: 99px; padding: 0.45rem 1rem; font-size: 0.825rem; font-weight: 800; cursor: pointer; border: none; white-space: nowrap; background: linear-gradient(135deg, #15803d, #166534); color: white;" %>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </section>



  <!-- Step-by-Step Preparation Method -->
  <section class="prep-container home-section-prep" style="margin-bottom: 4rem;">
    <div class="section-title-wrap" style="margin-bottom: 1.5rem;">
      <h2 class="section-title-main">Easy Preparation Method</h2>
      <p class="section-title-sub">Cook a healthy warm drink in 10 minutes</p>
    </div>
    
    <div class="prep-grid">
      <div class="prep-step">
        <div class="prep-number">1</div>
        <div class="prep-title">Measure Portion</div>
        <div class="prep-desc">Add 1½ tablespoons (15g) of Jeeni mix.</div>
      </div>
      <div class="prep-step">
        <div class="prep-number">2</div>
        <div class="prep-title">Mix with Water</div>
        <div class="prep-desc">Pour 250ml of clean water and mix well.</div>
      </div>
      <div class="prep-step">
        <div class="prep-number">3</div>
        <div class="prep-title">Stir to Smooth</div>
        <div class="prep-desc">Mix thoroughly to completely avoid any lumps.</div>
      </div>
      <div class="prep-step">
        <div class="prep-number">4</div>
        <div class="prep-title">Cook on Low Flame</div>
        <div class="prep-desc">Boil for 7–10 minutes while stirring continuously.</div>
      </div>
      <div class="prep-step">
        <div class="prep-number">5</div>
        <div class="prep-title">Add Flavor & Serve</div>
        <div class="prep-desc">Add jaggery, salt, or buttermilk as preferred. Serve warm!</div>
      </div>
    </div>
  </section>
</div>

<!-- Mobile Responsive Styles helper -->
<style>
  @media (max-width: 768px) {
    .home-limited-offer-card {
      grid-template-columns: 1fr !important;
      text-align: center !important;
      gap: 1rem !important;
    }
    .grid-mobile-1col {
      grid-template-columns: 1fr !important;
    }
  }
</style>

<!-- Auto-rotating Carousel Script -->
<script>
  let currentSlide = 0;
  const totalSlides = 3;
  let slideInterval = setInterval(nextSlide, 4500);

  function updateCarousel() {
    const slidesContainer = document.getElementById('hero-slider');
    if (!slidesContainer) return;
    slidesContainer.style.transform = `translateX(-${currentSlide * 100}%)`;
    const dots = document.querySelectorAll('.carousel-dot');
    dots.forEach((dot, index) => {
      if (index === currentSlide) {
        dot.classList.add('active');
      } else {
        dot.classList.remove('active');
      }
    });
  }

  function nextSlide() {
    const slidesContainer = document.getElementById('hero-slider');
    if (!slidesContainer) return;
    currentSlide = (currentSlide + 1) % totalSlides;
    updateCarousel();
  }

  function goToSlide(index) {
    const slidesContainer = document.getElementById('hero-slider');
    if (!slidesContainer) return;
    clearInterval(slideInterval);
    currentSlide = index;
    updateCarousel();
    slideInterval = setInterval(nextSlide, 4500);
  }
</script>
