<% content_for :title, "Reports & Analytics - Admin" %>

<!-- Load Chart.js CDN so Chartkick has a graphing engine -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns@3.0.0/dist/chartjs-adapter-date-fns.bundle.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartkick@5.0.1/dist/chartkick.js"></script>

<%
  query_params = request.query_parameters
  csv_url = "/admin_custom/reports/export?" + query_params.merge(format: :csv).to_query
  excel_url = "/admin_custom/reports/export?" + query_params.merge(format: :excel).to_query
  pdf_url = "/admin_custom/reports/export?" + query_params.merge(format: :pdf).to_query
%>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; border-bottom: 1px solid var(--border); padding-bottom: 1rem;" class="flex-mobile-col">
  <div>
    <h1 style="font-size: 2rem; font-weight: 700; color: var(--secondary);">Reports & Analytics</h1>
    <p style="color: var(--text-muted); margin-bottom: 0;">Visualize sales trends, geographic distribution of orders, and download spreadsheets.</p>
  </div>
  
  <!-- Export Actions Dropdown/Group -->
  <div style="display: flex; gap: 0.5rem; align-items: center; margin-top: 1rem;">
    <span style="font-weight: 600; font-size: 0.875rem; color: var(--text-muted);">Export Orders:</span>
    <a href="<%= csv_url %>" class="btn btn-outline btn-sm">📄 CSV</a>
    <a href="<%= excel_url %>" class="btn btn-outline btn-sm">📊 Excel</a>
    <a href="<%= pdf_url %>" target="_blank" class="btn btn-secondary btn-sm">📕 PDF Summary</a>
  </div>
</div>

<!-- Filters Panel Card -->
<div class="card admin-card" style="padding: 1rem 1.25rem; background-color: white; margin-bottom: 1.5rem; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);">
  <h3 style="font-size: 0.95rem; font-weight: 600; margin-bottom: 0.75rem; color: var(--secondary); display: flex; align-items: center; gap: 0.4rem;">
    <span>🔍</span> Filter Reports
  </h3>
  
  <%= form_tag admin_custom_reports_path, method: :get, id: "reports-filter-form" do %>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0.75rem; align-items: flex-end;">
      
      <!-- From Date -->
      <div style="display: flex; flex-direction: column; gap: 0.25rem;">
        <label for="from_date" style="font-size: 0.75rem; font-weight: 700; color: #475569;">From Date (with time)</label>
        <%= datetime_field_tag :from_date, params[:from_date], id: "from_date", class: "form-control", style: "width: 100%; border-radius: 8px; border: 1px solid #cbd5e1; padding: 0.35rem 0.6rem; font-size: 0.8rem; background-color: white;" %>
      </div>

      <!-- To Date -->
      <div style="display: flex; flex-direction: column; gap: 0.25rem;">
        <label for="to_date" style="font-size: 0.75rem; font-weight: 700; color: #475569;">To Date (with time)</label>
        <%= datetime_field_tag :to_date, params[:to_date], id: "to_date", class: "form-control", style: "width: 100%; border-radius: 8px; border: 1px solid #cbd5e1; padding: 0.35rem 0.6rem; font-size: 0.8rem; background-color: white;" %>
      </div>

      <!-- Payment Method -->
      <div style="display: flex; flex-direction: column; gap: 0.25rem;">
        <label for="payment_method_id" style="font-size: 0.75rem; font-weight: 700; color: #475569;">Payment Method</label>
        <%= select_tag :payment_method_id, options_from_collection_for_select(@payment_methods, :id, :name, params[:payment_method_id]), include_blank: "All Payment Methods", id: "payment_method_id", class: "form-control", style: "width: 100%; border-radius: 8px; border: 1px solid #cbd5e1; padding: 0.35rem 0.6rem; font-size: 0.8rem; background-color: white;" %>
      </div>

      <!-- Order Status -->
      <div style="display: flex; flex-direction: column; gap: 0.25rem;">
        <label for="order_status" style="font-size: 0.75rem; font-weight: 700; color: #475569;">Order Status</label>
        <%= select_tag :order_status, options_for_select(@order_statuses.map { |s| [s.titleize, s] }, params[:order_status]), include_blank: "All Statuses", id: "order_status", class: "form-control", style: "width: 100%; border-radius: 8px; border: 1px solid #cbd5e1; padding: 0.35rem 0.6rem; font-size: 0.8rem; background-color: white;" %>
      </div>

      <!-- Product -->
      <div style="display: flex; flex-direction: column; gap: 0.25rem;">
        <label for="product_id" style="font-size: 0.75rem; font-weight: 700; color: #475569;">Product</label>
        <%= select_tag :product_id, options_from_collection_for_select(@products, :id, :name, params[:product_id]), include_blank: "All Products", id: "product_id", class: "form-control", style: "width: 100%; border-radius: 8px; border: 1px solid #cbd5e1; padding: 0.35rem 0.6rem; font-size: 0.8rem; background-color: white;" %>
      </div>

      <!-- Action Buttons -->
      <div style="display: flex; gap: 0.4rem; justify-content: stretch; width: 100%;">
        <%= submit_tag "Apply Filter", class: "btn btn-primary btn-sm", style: "flex: 1; border-radius: 8px; font-weight: 700; cursor: pointer; padding: 0.45rem 0.8rem; border: none; background: var(--primary);" %>
        <%= link_to "Clear", admin_custom_reports_path, class: "btn btn-outline btn-sm", style: "flex: 1; text-align: center; border-radius: 8px; font-weight: 700; text-decoration: none; padding: 0.45rem 0.8rem; line-height: 1.2;" %>
      </div>

    </div>
  <%= hidden_field_tag :page, params[:page] if params[:page].present? %>
  <% end %>
</div>


<style>
  @media (max-width: 768px) {
    .flex-mobile-col {
      flex-direction: column !important;
      align-items: flex-start !important;
    }
  }

  .reports-pagination nav {
    display: flex;
    gap: 0.25rem;
  }
  .reports-pagination .page, .reports-pagination .current, .reports-pagination .first, .reports-pagination .last, .reports-pagination .prev, .reports-pagination .next {
    display: inline-block;
  }
  .reports-pagination .page a, .reports-pagination .first a, .reports-pagination .last a, .reports-pagination .prev a, .reports-pagination .next a {
    padding: 0.4rem 0.8rem;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    color: var(--secondary);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.85rem;
    background-color: white;
    transition: all 0.15s ease;
  }
  .reports-pagination .page a:hover, .reports-pagination .first a:hover, .reports-pagination .last a:hover, .reports-pagination .prev a:hover, .reports-pagination .next a:hover {
    background-color: #f1f5f9;
    border-color: #94a3b8;
  }
  .reports-pagination .current {
    padding: 0.4rem 0.8rem;
    background-color: var(--primary);
    color: white;
    border: 1px solid var(--primary);
    border-radius: 6px;
    font-weight: 700;
    font-size: 0.85rem;
  }
  .admin-card {
    height: auto !important;
    transform: none !important;
    transition: none !important;
  }
  .admin-card:hover {
    transform: none !important;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05) !important;
  }
</style>

<!-- Charts Dashboard Grid -->
<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;">
  <!-- Daily Sales Trend Chart -->
  <div class="card admin-card" style="padding: 2rem; background-color: white;">
    <h3 style="font-size: 1.1rem; font-weight: 600; margin-bottom: 1.5rem; color: var(--secondary); border-bottom: 1px solid var(--border); padding-bottom: 0.5rem;">Daily Sales Revenue Trend</h3>
    <% if @sales_by_day.any? %>
      <%= line_chart @sales_by_day, prefix: "₹", thousands: ",", xtitle: "Date", ytitle: "Sales (₹)" %>
    <% else %>
      <div style="padding: 3rem 1rem; text-align: center; color: var(--text-muted); font-size: 0.9rem;">
        No daily sales data available.
      </div>
    <% end %>
  </div>

  <!-- Geographical Sales Chart -->
  <div class="card admin-card" style="padding: 2rem; background-color: white;">
    <h3 style="font-size: 1.1rem; font-weight: 600; margin-bottom: 1.5rem; color: var(--secondary); border-bottom: 1px solid var(--border); padding-bottom: 0.5rem;">Sales by Geographical State</h3>
    <% if @sales_by_state.any? %>
      <%= bar_chart @sales_by_state, prefix: "₹", thousands: ",", xtitle: "Sales (₹)", ytitle: "State" %>
    <% else %>
      <div style="padding: 3rem 1rem; text-align: center; color: var(--text-muted); font-size: 0.9rem;">
        No geographic sales data available.
      </div>
    <% end %>
  </div>
</div>

<!-- Filtered Records Table Card -->
<div class="card admin-card" style="padding: 2rem; background-color: white; margin-top: 2.5rem; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05); margin-bottom: 4rem;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; border-bottom: 1px solid var(--border); padding-bottom: 0.75rem;" class="flex-mobile-col">
    <div>
      <h3 style="font-size: 1.1rem; font-weight: 600; color: var(--secondary); margin: 0;">Filtered Orders List</h3>
      <p style="color: var(--text-muted); font-size: 0.8rem; margin: 0.25rem 0 0 0;">
        <% if @orders.any? %>
          Showing <%= @orders.offset_value + 1 %> - <%= [@orders.offset_value + @orders.length, @orders.total_count].min %> of <%= @orders.total_count %> orders
        <% else %>
          Showing 0 orders
        <% end %>
      </p>
    </div>
  </div>

  <% if @orders.any? %>
    <div style="overflow-x: auto; -webkit-overflow-scrolling: touch; width: 100%;">
      <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.85rem; min-width: 800px;">
        <thead>
          <tr style="border-bottom: 2px solid var(--border); color: var(--secondary); font-weight: 700; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;">
            <th style="padding: 0.75rem 0.5rem;">Order Date</th>
            <th style="padding: 0.75rem 0.5rem;">Customer Name</th>
            <th style="padding: 0.75rem 0.5rem;">Phone no</th>
            <th style="padding: 0.75rem 0.5rem;">Total Amount</th>
            <th style="padding: 0.75rem 0.5rem;">Product</th>
            <th style="padding: 0.75rem 0.5rem;">Address</th>
            <th style="padding: 0.75rem 0.5rem; text-align: center;">Action</th>
          </tr>
        </thead>
        <tbody>
          <% @orders.each do |order| %>
            <%
              addr = order.ship_address || order.bill_address
              addr_str = addr ? [addr.full_name, addr.address1, addr.address2, addr.city, addr.state&.name || addr.state_name, addr.zipcode, addr.country&.name].reject(&:blank?).join(", ") : "N/A"
              prod_str = order.line_items.map { |li| "#{li.product&.name || li.variant&.name} (x#{li.quantity})" }.join(", ")
            %>
            <tr style="border-bottom: 1px solid var(--border); transition: background-color 0.15s;" onmouseover="this.style.backgroundColor='#f8fafc'" onmouseout="this.style.backgroundColor='transparent'">
              <td style="padding: 0.85rem 0.5rem; white-space: nowrap;"><%= order.completed_at&.in_time_zone('Kolkata')&.strftime("%Y-%m-%d %H:%M") || "N/A" %></td>
              <td style="padding: 0.85rem 0.5rem; font-weight: 600;"><%= addr&.full_name || "Guest" %></td>
              <td style="padding: 0.85rem 0.5rem;"><%= addr&.phone || "N/A" %></td>
              <td style="padding: 0.85rem 0.5rem; font-weight: 600; color: #15803d; white-space: nowrap;"><%= order.display_total.to_s %></td>
              <td style="padding: 0.85rem 0.5rem; max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: normal;"><%= prod_str %></td>
              <td style="padding: 0.85rem 0.5rem; max-width: 250px; overflow: hidden; text-overflow: ellipsis; white-space: normal; color: var(--text-muted);"><%= addr_str %></td>
              <td style="padding: 0.85rem 0.5rem; text-align: center;">
                <%= link_to "View ↗", admin_custom_order_path(order), class: "btn btn-outline btn-xs", style: "border-radius: 4px; padding: 0.25rem 0.5rem; font-size: 0.75rem; text-decoration: none;" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <!-- Pagination links -->
    <div style="margin-top: 1.5rem; display: flex; justify-content: center; align-items: center;" class="reports-pagination">
      <%= paginate @orders %>
    </div>
  <% else %>
    <div style="padding: 3rem 1rem; text-align: center; color: var(--text-muted); font-size: 0.95rem;">
      No orders match the selected filters.
    </div>
  <% end %>
</div>
