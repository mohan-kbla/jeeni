<%= form_for @faq, url: @faq.new_record? ? admin_custom_faqs_path : admin_custom_faq_path(@faq), method: @faq.new_record? ? :post : :patch do |f| %>
  <% if @faq.errors.any? %>
    <div class="alert alert-alert">
      <div>
        <strong><%= pluralize(@faq.errors.count, "error") %> prohibited this FAQ from being saved:</strong>
        <ul style="margin-left: 1.5rem; margin-top: 0.5rem;">
          <% @faq.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="card" style="padding: 2rem; background-color: white; margin-bottom: 2rem; max-width: 600px;">
    <div class="form-group">
      <%= f.label :question, "Question", class: "form-label" %>
      <%= f.text_field :question, class: "form-control", required: true, placeholder: "e.g., How long does delivery take?" %>
    </div>

    <div class="form-group">
      <%= f.label :answer, "Answer", class: "form-label" %>
      <%= f.text_area :answer, class: "form-control", rows: 4, required: true, placeholder: "Provide the detailed answer here..." %>
    </div>

    <div class="form-group">
      <%= f.label :product_id, "Associated Product (Optional)", class: "form-label" %>
      <%= f.collection_select :product_id, @products, :id, :name, { include_blank: "Global FAQ (Displays on storefront & general FAQ pages)" }, { class: "form-control" } %>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
      <div class="form-group">
        <%= f.label :position, "Display Order / Position", class: "form-label" %>
        <%= f.number_field :position, class: "form-control", required: true, min: 0 %>
      </div>

      <div class="form-group" style="display: flex; align-items: center; gap: 8px; margin-top: 2rem;">
        <%= f.check_box :active %>
        <%= f.label :active, "Active / Visible", style: "font-weight: 500; margin: 0; cursor: pointer;" %>
      </div>
    </div>
  </div>

  <div style="display: flex; gap: 1rem;">
    <%= f.submit "Save FAQ", class: "btn btn-primary" %>
    <a href="/admin_custom/faqs" class="btn btn-outline">Cancel</a>
  </div>
<% end %>
