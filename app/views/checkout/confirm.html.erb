<!-- Checkout Wizard Stepper -->
<div class="checkout-steps">
  <div class="checkout-step completed">1. Address</div>
  <div class="checkout-step completed">2. Delivery</div>
  <div class="checkout-step completed">3. Payment</div>
  <div class="checkout-step active">4. Confirm</div>
</div>

<div class="checkout-security-bar" style="display: flex; align-items: center; justify-content: center; gap: 0.5rem; background: #e7eedd; border: 1px solid #c5d9ad; color: var(--success); font-weight: 700; font-size: 0.9rem; padding: 0.6rem; border-radius: var(--radius-sm); margin-bottom: 1.5rem; text-align: center;">
  🔒 PCI-DSS Compliant & 256-Bit SSL Secured Order Review
</div>

<h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 2rem; color: var(--secondary); text-align: center;">Confirm Your Order</h2>

<div class="cart-checkout-grid">
  <!-- Left Column: Address, Delivery & Payment details -->
  <div>
    <!-- Addresses Grid -->
    <div style="margin-bottom: 2rem;">
      <!-- Delivery Address -->
      <div class="card" style="padding: 1.5rem; background-color: white;">
        <h3 style="font-size: 1rem; font-weight: 600; margin-bottom: 0.75rem; color: var(--secondary); border-bottom: 1px solid var(--border); padding-bottom: 0.25rem;">Delivery Address</h3>
        <% if @order.ship_address %>
          <p style="font-size: 0.9rem; color: #334155;">
            <strong><%= @order.ship_address.full_name %></strong><br>
            <%= @order.ship_address.address1 %><br>
            <% if @order.ship_address.address2.present? %><%= @order.ship_address.address2 %><br><% end %>
            <%= @order.ship_address.city %>, <%= @order.ship_address.state&.name || @order.ship_address.state_name %> <%= @order.ship_address.zipcode %><br>
            <%= @order.ship_address.country.name %><br>
            📞 <%= @order.ship_address.phone %>
          </p>
        <% end %>
      </div>
    </div>

    <!-- Shipment & Payment Details -->
    <div class="two-column-grid" style="margin-bottom: 2rem;">
      <div class="card" style="padding: 1.5rem; background-color: white;">
        <h3 style="font-size: 1rem; font-weight: 600; margin-bottom: 0.75rem; color: var(--secondary); border-bottom: 1px solid var(--border); padding-bottom: 0.25rem;">Shipping Method</h3>
        <% @order.shipments.each do |shipment| %>
          <p style="font-size: 0.9rem; color: #334155; font-weight: 500;">
            <%= shipment.shipping_method.name %> - <%= shipment.display_cost.to_s %>
          </p>
        <% end %>
      </div>

      <div class="card" style="padding: 1.5rem; background-color: white;">
        <h3 style="font-size: 1rem; font-weight: 600; margin-bottom: 0.75rem; color: var(--secondary); border-bottom: 1px solid var(--border); padding-bottom: 0.25rem;">Payment Method</h3>
        <% @order.payments.each do |payment| %>
          <p style="font-size: 0.9rem; color: #334155; font-weight: 500;">
            <%= payment.payment_method.name %>
          </p>
        <% end %>
      </div>
    </div>

    <!-- Line Items Table -->
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th>Product</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Total</th>
          </tr>
        </thead>
        <tbody>
          <% @order.line_items.each do |item| %>
            <tr>
              <td>
                <span style="font-weight: 600; color: var(--secondary);"><%= item.product.name %></span>
                <% if item.variant.options_text.present? %>
                  <span style="display: block; font-size: 0.75rem; color: var(--text-muted); margin-top: 0.15rem;"><%= item.variant.options_text %></span>
                <% end %>
              </td>
              <td><%= item.single_money.to_s %></td>
              <td><%= item.quantity %></td>
              <td style="font-weight: 600; color: var(--secondary);"><%= item.display_amount.to_s %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Right Column: Final Order Totals & Placement -->
  <div>
    <div class="card" style="padding: 1.5rem; background-color: white;">
      <h3 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 1.5rem; color: var(--secondary); border-bottom: 1px solid var(--border); padding-bottom: 0.75rem;">Totals</h3>
      
      <div style="display: flex; justify-content: space-between; margin-bottom: 0.75rem; font-size: 0.95rem;">
        <span style="color: var(--text-muted);">Subtotal</span>
        <span style="font-weight: 500;"><%= @order.display_item_total.to_s %></span>
      </div>
      
      <div style="display: flex; justify-content: space-between; margin-bottom: 0.75rem; font-size: 0.95rem;">
        <span style="color: var(--text-muted);">Shipping</span>
        <span style="font-weight: 500;"><%= @order.shipment_total == 0 ? "Free Delivery" : @order.display_shipment_total.to_s %></span>
      </div>

      <div style="display: flex; justify-content: space-between; margin-bottom: 1.25rem; font-size: 0.95rem; border-bottom: 1px solid var(--border); padding-bottom: 1rem;">
        <span style="color: var(--text-muted);">Taxes</span>
        <span style="font-weight: 500;"><%= @order.display_tax_total.to_s %></span>
      </div>
      
      <div style="display: flex; justify-content: space-between; margin-bottom: 2rem; font-size: 1.25rem; font-weight: 700; color: var(--secondary);">
        <span>Total</span>
        <span style="color: var(--primary);"><%= @order.display_total.to_s %></span>
      </div>
      <% payment = @order.payments.last %>
      <% if payment && payment.payment_method.is_a?(Spree::PaymentMethod::Razorpay) && payment.state != 'completed' %>
        <div style="padding: 1rem; background-color: #fee2e2; color: #b91c1c; border-radius: var(--radius-sm); border: 1px solid #fca5a5; font-size: 0.9rem; font-weight: 500; text-align: center; margin-bottom: 1.5rem; line-height: 1.5;">
          Online payment is pending. Please complete your payment or select Cash on Delivery.
        </div>
        <button class="btn btn-primary" style="width: 100%; padding: 0.875rem; font-size: 1rem; border-radius: var(--radius-md); opacity: 0.6; cursor: not-allowed;" disabled>
          Payment Pending
        </button>
      <% else %>
        <%= form_for @order, url: update_checkout_path, method: :patch do |f| %>
          <%= f.submit "Place Order", class: "btn btn-primary", style: "width: 100%; padding: 0.875rem; font-size: 1rem; border-radius: var(--radius-md);" %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<div class="checkout-actions" style="justify-content: flex-start; margin-top: 1rem;">
  <a href="/checkout/payment" class="btn btn-outline">&larr; Back to Payment</a>
</div>
