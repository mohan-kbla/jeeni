      <% end %>

      <!-- Product 2: Jeeni Sugaramla 1KG -->
      <% if @sugaramla_product.present? %>
        <div class="highlight-product-card highlight-product-card-sugaramla">
          <span class="highlight-badge highlight-badge-sugaramla">
            🔥 TOP RATED 1KG
          </span>

          <div class="highlight-card-body">
            <a href="/products/<%= @sugaramla_product.slug %>" class="highlight-img-link">
              <img src="<%= product_image_url(@sugaramla_product) %>" alt="<%= @sugaramla_product.name %>" class="highlight-img">
            </a>
            <div class="highlight-info">
              <div class="highlight-reviews">
                ⭐⭐⭐⭐⭐ 4.95 (980+ Reviews)
              </div>
              <h3 class="highlight-title">
                <a href="/products/<%= @sugaramla_product.slug %>"><%= @sugaramla_product.name %></a>
              </h3>
              <div class="highlight-price-row">
                <% if karnataka_visitor? && @sugaramla_product.karnataka_price.present? %>
                  <span class="highlight-price" style="color: #16a34a;">₹<%= @sugaramla_product.karnataka_price.to_i %></span>
                  <span class="highlight-old-price">₹<%= @sugaramla_product.price.to_i %></span>
                  <span class="highlight-save-badge highlight-save-badge-sugaramla" style="background: #16a34a; color: #ffffff;">KARNATAKA SPECIAL</span>
                <% else %>
                  <span class="highlight-price"><%= @sugaramla_product.display_price.to_s %></span>
                  <span class="highlight-save-badge highlight-save-badge-sugaramla">FAMILY PACK 1KG</span>
                <% end %>
              </div>
              <p class="highlight-desc">
                Traditional Amla & Herbal Grain Formula for Daily Immunity.
              </p>
            </div>
          </div>

          <div class="highlight-card-footer">
            <span class="highlight-gift-label highlight-gift-label-sugaramla">
              🎁 Includes FREE Gift!
            </span>
