<%
  slim = Spree::Product.active_products.find_by(slug: 'jeeni-slim-new') || 
         Spree::Product.active_products.where("LOWER(slug) LIKE '%slim%'").first
  sugaramla = Spree::Product.active_products.find_by(slug: 'jeeni-sugaramla-1kg-sugaramla-1kg') || 
              Spree::Product.active_products.where("LOWER(slug) LIKE '%sugaramla%'").first
%>
<style>
  /* Base Overrides for Premium Design */
  main {
    padding-top: 0 !important;
    background-color: #faf9f5;
  }

  .home-font-serif {
    font-family: 'Libre Baskerville', Georgia, serif !important;
  }

  .home-font-sans {
    font-family: 'Poppins', 'Inter', sans-serif !important;
  }

  .homepage-sections-wrapper {
    background-image: 
      url("<%= product_image_url(slim) if slim %>"),
      url("<%= product_image_url(sugaramla) if sugaramla %>"),
      linear-gradient(135deg, #fdfcf7 0%, #f4f1ea 100%);
    background-repeat: no-repeat, no-repeat, repeat;
    background-position: left 1% top 700px, right 1% top 1500px, center center;
    background-size: 240px auto, 240px auto, auto;
  }

  .premium-hero-container {
    background: transparent;
    padding: 6rem 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 4rem;
    max-width: 1200px;
    margin: 0 auto;
    box-sizing: border-box;
  }

  .premium-hero-left {
    flex: 0.85;
    max-width: 460px;
  }

  .premium-hero-tag {
    display: inline-block;
    background: #e8f5e9;
    color: #2d6a4f;
    padding: 0.3rem 0.85rem;
    border-radius: 99px;
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 1rem;
  }

  .premium-hero-title {
    font-family: 'Libre Baskerville', Georgia, serif;
    font-size: 2.5rem;
    font-weight: 800;
    color: #1b4332;
    line-height: 1.15;
    margin: 0 0 1.5rem 0;
    letter-spacing: -0.015em;
  }

  .premium-hero-desc {
    font-size: 1.1rem;
    color: #475569;
    line-height: 1.65;
    margin: 0 0 2.25rem 0;
  }

  .premium-hero-actions {
    display: flex;
    gap: 1.25rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .premium-hero-btn-primary {
    background: #2d6a4f;
    color: #ffffff !important;
    padding: 1rem 2.25rem;
    border-radius: 99px;
    font-size: 0.95rem;
    font-weight: 700;
    box-shadow: 0 4px 14px rgba(45, 106, 79, 0.35);
    transition: all 0.3s ease;
    border: none;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
  }

  .premium-hero-btn-primary:hover {
    background: #1b4332;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(45, 106, 79, 0.45);
  }

  .premium-hero-btn-secondary {
    border: 2px solid #2d6a4f;
    color: #2d6a4f !important;
    padding: 0.9rem 2.25rem;
    border-radius: 99px;
    font-size: 0.95rem;
    font-weight: 700;
    background: transparent;
    transition: all 0.3s ease;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
  }

  .premium-hero-btn-secondary:hover {
    background: rgba(45, 106, 79, 0.05);
    transform: translateY(-2px);
  }

  .premium-hero-right {
    flex: 1.15;
    max-width: 600px;
    position: relative;
  }

  .premium-hero-image-card {
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0,0,0,0.08);
    border: 4px solid #ffffff;
    background: #ffffff;
    transition: transform 0.4s ease;
  }

  .premium-hero-image-card:hover {
    transform: scale(1.02);
  }

  .premium-hero-floating-badge {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    margin-top: 1.5rem;
    background: #ffffff;
    padding: 0.85rem 1.25rem;
    border-radius: 16px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.06);
    display: flex;
    align-items: center;
    gap: 0.85rem;
    border: 1px solid #e2e8f0;
    white-space: nowrap;
    z-index: 10;
  }

  /* Product Showcase Cards Grid & Elements */
  .premium-showcase-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
    box-sizing: border-box;
  }

  .premium-signature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.25rem;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1rem;
    box-sizing: border-box;
  }

  @media (max-width: 1024px) {
    .premium-showcase-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
    .premium-signature-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
  }

  @media (max-width: 1024px) {
    .premium-hero-container {
      flex-direction: column;
      padding: 4rem 1.5rem;
      gap: 3.5rem;
      text-align: center;
      align-items: center;
      background: transparent;
    }
    .premium-hero-left {
      max-width: 650px;
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .premium-hero-right {
      max-width: 650px;
      width: 100%;
      position: relative;
    }
    .premium-hero-tag {
      align-self: center !important;
    }
    .premium-hero-actions {
      justify-content: center;
    }
    .premium-hero-floating-badge {
      bottom: auto;
    }
  }

  @media (max-width: 768px) {
    .premium-showcase-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
      padding: 0 0.5rem;
    }
    .premium-signature-grid {
      grid-template-columns: repeat(1, 1fr);
      gap: 1.5rem;
      padding: 0 1rem;
    }
    .homepage-sections-wrapper {
      background-image: 
        url("<%= product_image_url(slim) if slim %>"),
        url("<%= product_image_url(sugaramla) if sugaramla %>"),
        linear-gradient(135deg, #fdfcf7 0%, #f4f1ea 100%);
      background-repeat: no-repeat, no-repeat, repeat;
      background-position: left 2% top 900px, right 2% top 1800px, center center;
      background-size: 100px auto, 100px auto, auto;
    }
    .premium-hero-container {
      padding: 3rem 1rem;
      gap: 3rem;
    }
    .premium-hero-title {
      font-size: 1.85rem;
    }
  }

  @media (max-width: 480px) {
    .premium-hero-products-showcase {
      grid-template-columns: 1fr;
      gap: 1.25rem;
      width: 100%;
    }
    .premium-hero-prod-card {
      max-width: 290px;
      margin: 0 auto;
      width: 100%;
    }
    .premium-hero-floating-badge {
      position: relative;
      bottom: 0;
      left: 0;
      transform: none;
      margin: 1.5rem auto 0 auto;
      width: fit-content;
    }
  }

  .premium-showcase-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.03), 0 2px 4px -1px rgba(0, 0, 0, 0.015);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
