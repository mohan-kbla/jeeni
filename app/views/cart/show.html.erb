<% content_for :title, "Your Shopping Cart - Jeeni Shop" %>

<% if meta_pixel_id.present? && @order %>
  <script>
    if (typeof fbq !== 'undefined') {
      fbq('track', 'ViewCart', {
        value: <%= @order.total.to_f %>,
        currency: 'INR',
        content_ids: <%= raw @order.line_items.map { |li| li.variant.sku.presence || li.variant.id.to_s }.to_json %>,
        content_type: 'product',
        num_items: <%= @order.item_count %>
      });
    }
  </script>
<% end %>

<h1 style="font-size: 2rem; font-weight: 700; margin-bottom: 2rem; color: var(--secondary);">Shopping Cart</h1>

<% if @order && @order.line_items.any? %>
  <% is_eligible = PromotionService.unlocked_free_gift_promo?(@order) %>
  <% if is_eligible %>
    <div class="cart-promotion-banner" style="background: linear-gradient(135deg, #fef3c7, #fde68a); border: 2px solid #f59e0b; border-radius: 12px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem;">
      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <span style="font-size: 1.8rem;">🎉</span>
        <div>
          <strong style="color: #78350f; font-size: 1rem; display: block;">Congratulations! You unlocked:</strong>
          <div style="display: flex; gap: 1rem; margin-top: 0.25rem; flex-wrap: wrap;">
            <span style="color: #15803d; font-weight: 800; font-size: 0.9rem;">✅ FREE Vegetable Coffee</span>
            <span style="color: #15803d; font-weight: 800; font-size: 0.9rem;">✅ FREE Delivery</span>
          </div>
        </div>
      </div>
      <span style="background: #b45309; color: white; font-weight: 800; font-size: 0.75rem; padding: 0.3rem 0.75rem; border-radius: 999px;">ONLINE PAYMENT SPECIAL</span>
    </div>
  <% else %>
    <div class="cart-promotion-banner" style="background: #f0fdf4; border: 1.5px solid #86efac; border-radius: 12px; padding: 0.85rem 1.25rem; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.75rem;">
      <span style="font-size: 1.5rem;">🚚</span>
      <div>
        <strong style="color: #14532d; font-size: 0.95rem;">Free Delivery Applied</strong>
        <span style="color: #166534; font-size: 0.85rem; display: block;">Enjoy 100% Free Shipping on your order today!</span>
      </div>
    </div>
  <% end %>

  <div class="cart-checkout-grid">
    <!-- Cart Items list -->
    <div>
      <div class="table-responsive">
        <table class="table cart-table">
          <thead>
            <tr>
              <th colspan="2">Product</th>
              <th>Price</th>
              <th>Quantity</th>
              <th>Total</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% @order.line_items.each do |item| %>
              <tr>
                <!-- Product Image -->
                <td class="cart-product-image" style="width: 80px;">
                  <div style="width: 60px; height: 60px; border-radius: var(--radius-sm); overflow: hidden; background: #f1f5f9; border: 1px solid var(--border);">
                    <img src="<%= product_image_url(item.product) %>" style="width: 100%; height: 100%; object-fit: cover;" alt="<%= item.product.name %>">
                  </div>
                </td>
                
                <!-- Product details -->
                <td class="cart-product-details">
                  <h4 style="font-size: 1rem; font-weight: 600; color: var(--secondary);"><a href="/products/<%= item.product.slug %>"><%= item.product.name %></a></h4>
                  <% if item.variant.options_text.present? %>
                    <p style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;"><%= item.variant.options_text %></p>
                  <% end %>
                </td>
                
                <!-- Unit Price -->
                <td class="cart-product-price" data-label="Price"><%= item.single_money.to_s %></td>
                
                <!-- Quantity form -->
                <td class="cart-product-quantity" data-label="Quantity">
                  <%= form_tag update_cart_path, method: :patch, style: "display: flex; align-items: center; gap: 0.5rem;" do %>
                    <%= hidden_field_tag :line_item_id, item.id %>
                    <%= number_field_tag :quantity, item.quantity, min: 1, max: 100, class: "form-control", style: "width: 70px; padding: 0.4rem; text-align: center;" %>
                    <button type="submit" class="btn btn-outline btn-sm" style="padding: 0.4rem 0.6rem; font-size: 0.75rem;" title="Update quantity">🔄</button>
                  <% end %>
                </td>
                
                <!-- Total Price -->
                <td class="cart-product-total" data-label="Total" style="font-weight: 600; color: var(--secondary);"><%= item.display_amount.to_s %></td>
                
                <!-- Remove item button -->
                <td class="cart-product-remove">
                  <%= button_to remove_from_cart_path(line_item_id: item.id), method: :delete, class: "btn btn-outline btn-sm", style: "border-color: #fee2e2; color: var(--danger); padding: 0.4rem 0.6rem;", data: { confirm: "Are you sure?" } do %>
                    🗑️
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      
      <div style="margin-top: 1.5rem;">
        <a href="/products" class="btn btn-outline">&larr; Continue Shopping</a>
      </div>
    </div>

    <!-- Order Summary Card -->
    <div>
      <div class="card" style="padding: 1.5rem; background-color: white;">
        <h3 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 1.5rem; color: var(--secondary); border-bottom: 1px solid var(--border); padding-bottom: 0.75rem;">Order Summary</h3>
        
        <div style="display: flex; justify-content: space-between; margin-bottom: 0.75rem; font-size: 0.95rem;">
          <span style="color: var(--text-muted);">Subtotal</span>
          <span style="font-weight: 500;"><%= @order.display_item_total.to_s %></span>
        </div>
        
        <div style="display: flex; justify-content: space-between; margin-bottom: 0.75rem; font-size: 0.95rem;">
          <span style="color: var(--text-muted);">Shipping (Est.)</span>
          <span style="font-weight: 500;"><%= @order.shipment_total == 0 ? "Free Delivery" : @order.display_shipment_total.to_s %></span>
        </div>

        <div style="display: flex; justify-content: space-between; margin-bottom: 1.25rem; font-size: 0.95rem; border-bottom: 1px solid var(--border); padding-bottom: 1rem;">
          <span style="color: var(--text-muted);">Taxes (Est.)</span>
          <span style="font-weight: 500;"><%= @order.display_tax_total.to_s %></span>
        </div>
        
        <div style="display: flex; justify-content: space-between; margin-bottom: 2rem; font-size: 1.25rem; font-weight: 700; color: var(--secondary);">
          <span>Total</span>
          <span style="color: var(--primary);"><%= @order.display_total.to_s %></span>
        </div>
        
        <a href="/checkout" class="btn btn-primary" style="width: 100%; padding: 0.875rem; font-size: 1rem; border-radius: var(--radius-md);">Proceed to Checkout</a>
      </div>
    </div>
  </div>
<% else %>
  <div style="text-align: center; padding: 5rem 2rem; background: white; border: 1px solid var(--border); border-radius: var(--radius-md); max-width: 600px; margin: 0 auto;">
    <span style="font-size: 4rem; display: block; margin-bottom: 1.5rem;">🛒</span>
    <h3 style="font-size: 1.5rem; font-weight: 700; color: var(--secondary); margin-bottom: 0.5rem;">Your Cart is Empty</h3>
    <p style="color: var(--text-muted); margin-bottom: 2rem;">Looks like you haven't added any products to your cart yet. Let's find something premium for you!</p>
    <a href="/products" class="btn btn-primary" style="padding: 0.75rem 2rem;">Explore Products</a>
  </div>
<% end %>
