<% content_for :title, "Product Management - Admin" %>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
  <div>
    <h1 style="font-size: 2rem; font-weight: 700; color: var(--secondary);">Products Management</h1>
    <p style="color: var(--text-muted);">Manage shop inventory, details, location tags, prices, and visibility.</p>
  </div>
  <div>
    <a href="/admin_custom/products/new" class="btn btn-primary">➕ Create Product</a>
  </div>
</div>

<% if @products.any? %>
  <div class="table-responsive">
    <table class="table">
      <thead>
        <tr>
          <th>SKU</th>
          <th>Name</th>
          <th>Category</th>
          <th>Price</th>
          <th>Location</th>
          <th>Featured</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @products.each do |product| %>
          <tr>
            <td style="font-family: monospace; font-size: 0.8rem;"><%= product.sku %></td>
            <td style="font-weight: 600; color: var(--secondary);"><%= product.name %></td>
            <td>
              <span style="font-size: 0.85rem; background: #e2e8f0; color: #475569; padding: 0.2rem 0.5rem; border-radius: 4px; font-weight: 500;">
                <%= product.category&.name.presence || product.category&.root&.name.presence || 'None' %>
              </span>
            </td>
            <td style="font-weight: 600; color: var(--primary);"><%= product.display_price.to_s %></td>
            <td>
              <%= [product.district, product.state].compact.reject(&:empty?).join(', ') %>
            </td>
            <td>
              <span class="badge <%= product.featured? ? 'badge-success' : 'badge-danger' %>">
                <%= product.featured? ? 'Yes' : 'No' %>
              </span>
            </td>
            <td>
              <%= button_to toggle_visibility_admin_custom_product_path(product), method: :post, class: "btn btn-sm #{product.active? ? 'btn-success' : 'btn-outline'}", style: "padding: 0.35rem 0.65rem; font-size: 0.8rem; font-weight: 600; text-decoration: none; border-radius: var(--radius-sm); border: 1px solid #{product.active? ? '#059669' : '#cbd5e1'};" do %>
                <%= product.active? ? '👁️ Shown' : '🙈 Hidden' %>
              <% end %>
            </td>
            <td style="display: flex; gap: 0.5rem;">
              <a href="/admin_custom/products/<%= product.slug %>" class="btn btn-outline btn-sm" style="padding: 0.4rem 0.6rem;">👁️ View</a>
              <a href="/admin_custom/products/<%= product.slug %>/edit" class="btn btn-secondary btn-sm" style="padding: 0.4rem 0.6rem;">✏️ Edit</a>
              <%= button_to admin_custom_product_path(product), method: :delete, class: "btn btn-outline btn-sm", style: "border-color: #fee2e2; color: var(--danger); padding: 0.4rem 0.6rem;", data: { confirm: "Permanently delete this product?" } do %>
                🗑️
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  
  <div style="display: flex; justify-content: center; margin-top: 2rem;">
    <%= paginate @products %>
  </div>
<% else %>
  <div style="text-align: center; padding: 5rem 2rem; background: white; border: 1px solid var(--border); border-radius: var(--radius-md);">
    <span style="font-size: 3rem; display: block; margin-bottom: 1rem;">📦</span>
    <h3 style="font-size: 1.25rem; font-weight: 700; color: var(--secondary); margin-bottom: 0.5rem;">No Products</h3>
    <p style="color: var(--text-muted); margin-bottom: 1.5rem;">There are no products in the catalog.</p>
    <a href="/admin_custom/products/new" class="btn btn-primary">Create Your First Product</a>
  </div>
<% end %>
