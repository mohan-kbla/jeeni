<%= form_for @taxonomy, url: @taxonomy.new_record? ? admin_custom_categories_path : admin_custom_category_path(@taxonomy), method: @taxonomy.new_record? ? :post : :patch do |f| %>
  <% if @taxonomy.errors.any? %>
    <div class="alert alert-alert">
      <div>
        <strong><%= pluralize(@taxonomy.errors.count, "error") %> prohibited this category from being saved:</strong>
        <ul style="margin-left: 1.5rem; margin-top: 0.5rem;">
          <% @taxonomy.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="card" style="padding: 2rem; background-color: white; margin-bottom: 2rem; max-width: 500px;">
    <div class="form-group">
      <%= f.label :name, class: "form-label", for: "cat-name" do %>
        Category Name <span style="color: var(--danger);">*</span>
      <% end %>
      <%= f.text_field :name, class: "form-control", required: true, id: "cat-name", placeholder: "e.g., Clothing, Electronics" %>
    </div>
  </div>

  <div style="display: flex; gap: 1rem;">
    <%= f.submit "Save Category", class: "btn btn-primary" %>
    <a href="/admin_custom/categories" class="btn btn-outline">Cancel</a>
  </div>
<% end %>
