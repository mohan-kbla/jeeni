          <p style="font-size: 0.85rem; color: #64748b; margin-top: 0.25rem;">Enter your pincode to unlock Karnataka Special prices!</p>
        </div>
        
        <div id="modal-pincode-error" style="display: none; background: #fef2f2; border: 1px solid #fca5a5; color: #b91c1c; font-size: 0.85rem; padding: 0.6rem; border-radius: 8px; margin-bottom: 1rem; font-weight: 600; text-align: center;"></div>
        
        <div class="form-group" style="margin-bottom: 1.25rem;">
          <input type="text" id="modal-pincode-input" placeholder="Enter 6-digit Pincode" maxlength="6" inputmode="numeric" style="width: 100%; padding: 0.75rem 1rem; border: 2px solid #cbd5e1; border-radius: 10px; font-size: 1rem; font-weight: 700; text-align: center; color: #0f172a; box-sizing: border-box; outline: none; transition: border-color 0.2s;" oninput="this.value = this.value.replace(/[^0-9]/g, '');">
        </div>
        
        <button onclick="submitPincode();" style="width: 100%; padding: 0.75rem; background: #15803d; color: #ffffff; border: none; border-radius: 10px; font-weight: 800; font-size: 1rem; cursor: pointer; transition: background 0.2s; border-radius: 8px;">Check Location</button>
        
        <div style="text-align: center; margin-top: 1rem; border-top: 1px solid #f1f5f9; padding-top: 1rem;">
          <button onclick="selectKarnatakaState();" style="background: none; border: none; color: #15803d; font-weight: 700; font-size: 0.85rem; cursor: pointer; text-decoration: underline;">Directly set Karnataka State</button>
        </div>
      </div>
    </div>

    <script>
      function openLocationModal() {
        document.getElementById('locationModal').style.display = 'flex';
        document.getElementById('modal-pincode-input').focus();
      }

      function closeLocationModal() {
        document.getElementById('locationModal').style.display = 'none';
      }

      function selectKarnatakaState() {
        setVisitorLocation({ state: 'karnataka' });
      }

      function submitPincode() {
        const pin = document.getElementById('modal-pincode-input').value.trim();
        if (pin.length !== 6) {
          const err = document.getElementById('modal-pincode-error');
          err.innerText = 'Pincode must be exactly 6 digits';
          err.style.display = 'block';
          return;
        }
        setVisitorLocation({ pincode: pin });
      }

      function setVisitorLocation(data) {
        const btn = document.querySelector('#locationModal button[onclick*="submitPincode"]');
        const originalText = btn ? btn.innerText : 'Check Location';
        if (btn) btn.innerText = 'Checking...';
        
        fetch('/api/set_location', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        })
        .then(res => res.json())
        .then(res => {
          if (res.success) {
            closeLocationModal();
            window.location.reload();
          } else {
            const err = document.getElementById('modal-pincode-error');
            err.innerText = res.message || 'Error checking location';
            err.style.display = 'block';
            if (btn) btn.innerText = originalText;
          }
        })
        .catch(e => {
          const err = document.getElementById('modal-pincode-error');
          err.innerText = 'Connection error';
          err.style.display = 'block';
          if (btn) btn.innerText = originalText;
        });
      }

      // Auto-detect visitor location on first load if not set
      <% if !session[:visitor_state].present? && !session[:visitor_pincode].present? %>
        document.addEventListener("DOMContentLoaded", function() {
          if (!sessionStorage.getItem('location_detected')) {
            sessionStorage.setItem('location_detected', 'true');
            
            function detectKarnataka(url, fallbackFn) {
              fetch(url)
                .then(res => res.json())
                .then(data => {
                  const region = data.regionName || data.region || '';
                  if (region && region.toLowerCase() === 'karnataka') {
                    setVisitorLocation({ state: 'karnataka' });
                  } else if (fallbackFn) {
                    fallbackFn();
                  }
                })
                .catch(e => {
                  if (fallbackFn) fallbackFn();
                });
            }
            
            detectKarnataka('https://freeipapi.com/api/json', function() {
              detectKarnataka('https://ipapi.co/json/');
            });
          }
        });
      <% end %>
    </script>
  </body>
</html>
