<div class="page-header-flex" style="margin-bottom: 2rem;">
  <div>
    <h1 style="font-size: 1.5rem; font-weight: 700; color: var(--secondary); margin: 0;">❓ FAQs Manager</h1>
    <p style="color: var(--text-muted); margin-top: 0.25rem;">Manage the Q&A content displayed under product descriptions.</p>
  </div>
  <a href="/admin_custom/faqs/new" class="btn btn-primary">➕ Add FAQ</a>
</div>

<div class="card" style="background-color: white; border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-sm);">
  <% if @faqs.any? %>
    <table class="table" style="margin: 0; width: 100%; border-collapse: collapse; text-align: left;">
      <thead>
        <tr style="background-color: var(--bg-main); border-bottom: 1px solid var(--border);">
          <th style="padding: 1rem;">Scope / Product</th>
          <th style="padding: 1rem;">Question</th>
          <th style="padding: 1rem;">Answer</th>
          <th style="padding: 1rem; text-align: center;">Position</th>
          <th style="padding: 1rem;">Status</th>
          <th style="padding: 1rem; text-align: right;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @faqs.each do |faq| %>
          <tr style="border-bottom: 1px solid var(--border);">
            <td style="padding: 1rem; font-weight: 600; color: var(--secondary); font-size: 0.9rem;">
              <%= faq.product ? faq.product.name : "Global Storefront" %>
            </td>
            <td style="padding: 1rem; color: var(--text-main); font-weight: 600; font-size: 0.9rem; max-width: 200px;">
              <%= faq.question %>
            </td>
            <td style="padding: 1rem; color: var(--text-muted); font-size: 0.85rem; max-width: 250px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
              <%= faq.answer %>
            </td>
            <td style="padding: 1rem; text-align: center; font-size: 0.9rem; color: var(--text-main);">
              <%= faq.position %>
            </td>
            <td style="padding: 1rem;">
              <span class="badge <%= faq.active? ? 'badge-success' : 'badge-danger' %>">
                <%= faq.active? ? 'Active' : 'Inactive' %>
              </span>
            </td>
            <td style="padding: 1rem; text-align: right; white-space: nowrap;">
              <div style="display: flex; gap: 0.5rem; justify-content: flex-end;">
                <a href="/admin_custom/faqs/<%= faq.id %>/edit" class="btn btn-secondary btn-sm">Edit</a>
                <%= button_to admin_custom_faq_path(faq), method: :delete, class: "btn btn-outline btn-sm", style: "color: var(--danger); border-color: #fee2e2;", data: { confirm: "Are you sure you want to delete this FAQ?" } do %>
                  Delete
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div style="padding: 3rem; text-align: center; color: var(--text-muted);">
      <div style="font-size: 3rem; margin-bottom: 1rem;">❓</div>
      <p style="font-weight: 500;">No FAQs configured yet.</p>
      <a href="/admin_custom/faqs/new" class="btn btn-primary btn-sm" style="margin-top: 1rem;">Add your first FAQ</a>
    </div>
  <% end %>
</div>
