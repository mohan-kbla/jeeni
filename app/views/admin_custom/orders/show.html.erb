<% content_for :title, "Manage Order #{@order.number} - Admin" %>

<!-- CSS / Toggle visibility based on edit-mode class on container -->
<style>
  .order-container.editing .view-mode {
    display: none !important;
  }
  .order-container:not(.editing) .edit-mode {
    display: block !important;
  }
  .order-container:not(.editing) span.edit-mode,
  .order-container:not(.editing) div.edit-mode {
    display: none !important;
  }
</style>

<!-- Breadcrumbs -->
<div style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 1.5rem;">
  <a href="/admin_custom">Dashboard</a> / <a href="/admin_custom/orders">Orders</a> / <span style="color: var(--text-main); font-weight: 500;">Fulfillment</span>
</div>

<div class="order-container" id="orderContainer">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; border-bottom: 1px solid var(--border); padding-bottom: 1rem;">
    <div>
      <h1 style="font-size: 2rem; font-weight: 700; color: var(--secondary);">Manage Order: <%= @order.number %></h1>
      <p style="color: var(--text-muted); margin-top: 0.25rem; display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
        <span>Placed on <%= @order.completed_at.strftime("%B %d, %Y at %I:%M %p") %> by</span>
        <span class="view-mode">
          <% if @order.respond_to?(:guest_order?) && (@order.guest_order? || @order.email.to_s.start_with?("guest_")) %>
            <span class="badge badge-info" style="font-size: 0.75rem;">Guest</span>
            <%= @order.ship_address&.full_name.presence || @order.bill_address&.full_name.presence || 'Guest' %>
          <% else %>
            <%= @order.email %>
          <% end %>
        </span>
        <span class="edit-mode" style="display: inline-flex; align-items: center; gap: 0.25rem;">
          <input type="email" name="order[email]" value="<%= @order.email %>" form="editOrderForm" class="form-control" style="padding: 0.25rem 0.5rem; font-size: 0.85rem; width: 250px; background-color: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-sm);" required>
        </span>
      </p>
    </div>
    <div style="display: flex; gap: 0.5rem; align-items: center;">
      <a href="/orders/<%= @order.number %>/invoice" target="_blank" class="btn btn-outline view-mode">📄 View Invoice PDF</a>
      <button type="button" class="btn btn-primary view-mode" id="btnEdit" onclick="setEditMode(true)">✏️ Edit Order</button>
      <button type="submit" form="editOrderForm" class="btn btn-success edit-mode" id="btnSave">💾 Save Changes</button>
      <button type="button" class="btn btn-outline edit-mode" id="btnCancel" onclick="setEditMode(false)">❌ Cancel</button>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 2rem; margin-bottom: 3rem; align-items: start;">
    <!-- Left Panel: Shipments, Payments, and Items -->
    <div style="display: flex; flex-direction: column; gap: 2rem;">
      
      <!-- Order Status Card -->
      <div class="card" style="padding: 1.5rem; background-color: #f0fdf4; border: 1.5px solid #bbf7d0; height: auto; flex-shrink: 0; display: flex; flex-direction: column; gap: 0.5rem;">
        <h3 style="font-size: 1rem; font-weight: 700; color: #166534; border-bottom: 1px solid #dcfce7; padding-bottom: 0.4rem; margin-bottom: 0.25rem; display: flex; align-items: center; justify-content: space-between;">
          <span>📌 Order Status</span>
          <span class="badge badge-success view-mode" style="font-size: 0.8rem; text-transform: uppercase;"><%= @order.state&.titleize %></span>
        </h3>
        <div class="edit-mode" style="margin-top: 0.25rem;">
          <label style="font-weight: 600; font-size: 0.85rem; color: var(--secondary); display: block; margin-bottom: 0.25rem;">Select Order State:</label>
          <select name="order[state]" form="editOrderForm" class="form-control" style="width: 100%; max-width: 250px; padding: 0.35rem 0.5rem; font-size: 0.9rem; background-color: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-sm);">
            <% [
              ['Cart', 'cart'],
              ['Address', 'address'],
              ['Delivery', 'delivery'],
              ['Payment', 'payment'],
              ['Confirm', 'confirm'],
              ['Payment Confirm', 'payment_confirm'],
              ['Complete', 'complete'],
              ['Canceled', 'canceled'],
              ['Awaiting Return', 'awaiting_return'],
              ['Returned', 'returned'],
              ['Resumed', 'resumed'],
              ['Dispatched', 'dispatched'],
              ['Out for Delivery', 'out_for_delivery'],
              ['Delivered', 'delivered']
            ].each do |label, value| %>
              <option value="<%= value %>" <%= 'selected' if @order.state == value %>><%= label %></option>
            <% end %>
          </select>
        </div>
        <div style="font-size: 0.85rem; color: #166534; line-height: 1.4;">
          <div><strong>Payment State:</strong> <%= @order.payment_state&.titleize || 'Pending' %></div>
          <div><strong>Shipment State:</strong> <%= @order.shipment_state&.titleize || 'Pending' %></div>
        </div>
      </div>

      <!-- Promotion & Gift Audit Box -->
      <%
        has_free_gift = @order.line_items.any? { |li| li.price == 0.0 || li.variant&.product&.slug.to_s.include?('vegetable') }
        payment_type = @order.payments.valid.last&.payment_method&.name.to_s.presence || "Online Payment"
        is_online = !payment_type.downcase.include?('cod') && !payment_type.downcase.include?('cash')
      %>
      <div class="card" style="padding: 1.5rem; background-color: #fefce8; border: 1.5px solid #fde047; height: auto; flex-shrink: 0;">
        <h3 style="font-size: 1rem; font-weight: 700; margin-bottom: 0.75rem; color: #854d0e; border-bottom: 1px solid #fef08a; padding-bottom: 0.4rem; display: flex; align-items: center; gap: 0.5rem;">
          🏷️ Promotion & Offer Status
        </h3>
        <div style="display: flex; flex-direction: column; gap: 0.5rem; font-size: 0.9rem;">
          <div><strong>Payment Type:</strong> <span class="badge <%= is_online ? 'badge-success' : 'badge-info' %>"><%= payment_type %></span></div>
          <div><strong>Free Delivery:</strong> <span style="color: #15803d; font-weight: 800;">✅ Applied (Free Shipping)</span></div>
          <div><strong>Free Vegetable Coffee Gift:</strong> 
            <% if has_free_gift %>
              <span style="color: #15803d; font-weight: 800;">🎁 Included (₹0 Promotional Line Item)</span>
            <% else %>
              <span style="color: #b45309; font-weight: 600;">❌ Not Applicable (<%= is_online ? 'No eligible main product' : 'COD payment method selected' %>)</span>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Shipments Management -->
      <div class="card" style="padding: 2rem; background-color: white; height: auto; flex-shrink: 0;">
        <h3 style="font-size: 1.1rem; font-weight: 600; margin-bottom: 1rem; color: var(--secondary); border-bottom: 1px solid var(--border); padding-bottom: 0.5rem;">Shipment Operations</h3>
        <% @order.shipments.each do |shipment| %>
          <div style="display: flex; justify-content: space-between; align-items: center; padding: 1rem; border: 1px solid var(--border); border-radius: var(--radius-sm); margin-bottom: 1rem; background-color: #f8fafc;">
            <div>
              <strong style="color: var(--secondary);"><%= shipment.number %></strong> from <%= shipment.stock_location.name %><br>
              <span style="font-size: 0.85rem; color: var(--text-muted);">Method: <%= shipment.shipping_method.name %> (<%= shipment.display_cost.to_s %>)</span>
            </div>
            <div style="display: flex; align-items: center; gap: 1rem;">
              <% ship_badge_class = case shipment.state
                 when 'shipped' then 'badge-success'
                 when 'ready' then 'badge-info'
                 else 'badge-danger'
                 end %>
              <span class="badge <%= ship_badge_class %>" style="padding: 0.35rem 0.65rem;"><%= shipment.state.capitalize %></span>
              
              <% if shipment.can_ship? && !(spree_current_user.respond_to?(:read_only_orders?) && spree_current_user.read_only_orders?) %>
                <%= form_tag admin_custom_order_path(@order.number), method: :patch do %>
                  <%= hidden_field_tag :shipment_id, shipment.id %>
                  <%= hidden_field_tag :shipment_action, "ship" %>
                  <%= submit_tag "🚚 Ship Items", class: "btn btn-primary btn-sm" %>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Payments Management -->
      <div class="card" style="padding: 2rem; background-color: white; height: auto; flex-shrink: 0;">
        <h3 style="font-size: 1.1rem; font-weight: 600; margin-bottom: 1rem; color: var(--secondary); border-bottom: 1px solid var(--border); padding-bottom: 0.5rem;">Payment Transaction</h3>
        <% @order.payments.each do |payment| %>
          <div style="display: flex; justify-content: space-between; align-items: center; padding: 1rem; border: 1px solid var(--border); border-radius: var(--radius-sm); margin-bottom: 1rem; background-color: #f8fafc;">
            <div>
              <strong style="color: var(--secondary);"><%= payment.payment_method.name %></strong><br>
              <span style="font-size: 0.85rem; color: var(--text-muted);">Amount: <%= payment.display_amount.to_s %></span>
            </div>
            <div style="display: flex; align-items: center; gap: 1rem;">
              <% pay_badge_class = case payment.state
                 when 'completed' then 'badge-success'
                 when 'void' then 'badge-danger'
                 else 'badge-warning'
                 end %>
              <span class="badge <%= pay_badge_class %>" style="padding: 0.35rem 0.65rem;"><%= payment.state.capitalize %></span>
              
              <% if ['checkout', 'pending'].include?(payment.state) && !(spree_current_user.respond_to?(:read_only_orders?) && spree_current_user.read_only_orders?) %>
                <%= form_tag admin_custom_order_path(@order.number), method: :patch do %>
                  <%= hidden_field_tag :payment_id, payment.id %>
                  <%= hidden_field_tag :payment_action, "capture" %>
                  <%= submit_tag "💰 Capture Payment", class: "btn btn-primary btn-sm" %>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Line Items Table -->
      <div class="card" style="padding: 2rem; background-color: white; height: auto; flex-shrink: 0;">
        <h3 style="font-size: 1.1rem; font-weight: 600; margin-bottom: 1rem; color: var(--secondary); border-bottom: 1px solid var(--border); padding-bottom: 0.5rem;">Order Items</h3>
        <div class="table-responsive" style="margin-bottom: 0;">
          <table class="table">
            <thead>
              <tr>
                <th>Product</th>
                <th>Sku</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Total</th>
              </tr>
            </thead>
            <tbody>
              <% @order.line_items.each do |item| %>
                <tr>
                  <td>
                    <span style="font-weight: 600; color: var(--secondary);"><%= item.product.name %></span>
                    <% if item.variant.options_text.present? %>
                      <span style="display: block; font-size: 0.75rem; color: var(--text-muted); margin-top: 0.15rem;"><%= item.variant.options_text %></span>
                    <% end %>
                  </td>
                  <td style="font-family: monospace; font-size: 0.8rem;"><%= item.variant.sku %></td>
                  <td><%= item.single_money.to_s %></td>
                  <td><%= item.quantity %></td>
                  <td style="font-weight: 600; color: var(--secondary);"><%= item.display_amount.to_s %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Right Panel: Addresses & Totals -->
    <div style="display: flex; flex-direction: column; gap: 1.5rem;">
      <!-- Order Totals -->
      <div class="card" style="padding: 1.5rem; background-color: white; height: auto; flex-shrink: 0;">
        <h3 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 1.25rem; color: var(--secondary); border-bottom: 1px solid var(--border); padding-bottom: 0.5rem;">Totals</h3>
        <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem; font-size: 0.9rem;">
          <span style="color: var(--text-muted);">Subtotal</span>
          <span><%= @order.display_item_total.to_s %></span>
        </div>
        <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem; font-size: 0.9rem;">
          <span style="color: var(--text-muted);">Shipping</span>
          <span><%= @order.shipment_total == 0 ? "Free Delivery" : @order.display_shipment_total.to_s %></span>
        </div>
        <div style="display: flex; justify-content: space-between; margin-bottom: 0.75rem; font-size: 0.9rem; border-bottom: 1px solid var(--border); padding-bottom: 0.5rem;">
          <span style="color: var(--text-muted);">Taxes</span>
          <span><%= @order.display_tax_total.to_s %></span>
        </div>
        <div style="display: flex; justify-content: space-between; align-items: center; font-size: 1.2rem; font-weight: 700; color: var(--secondary); flex-wrap: nowrap; gap: 0.5rem;">
          <span style="white-space: nowrap; flex-shrink: 0;">Order Total</span>
          <span style="color: var(--primary); white-space: nowrap; flex-shrink: 0;"><%= @order.display_total.to_s %></span>
        </div>
      </div>

      <!-- Billing Address -->
      <div class="card" style="padding: 1.5rem; background-color: white; height: auto; flex-shrink: 0;">
        <h3 style="font-size: 1rem; font-weight: 600; margin-bottom: 0.75rem; color: var(--secondary); border-bottom: 1px solid var(--border); padding-bottom: 0.25rem;">Billing Address</h3>
        <% if @order.bill_address %>
          <div class="view-mode" style="font-size: 0.85rem; color: #475569; line-height: 1.5;">
            <strong><%= @order.bill_address.full_name %></strong><br>
            <%= @order.bill_address.address1 %><br>
            <% if @order.bill_address.address2.present? %>
              <%= @order.bill_address.address2 %><br>
            <% end %>
            <%= @order.bill_address.city %>, <%= @order.bill_address.state&.name || @order.bill_address.state_name %> <%= @order.bill_address.zipcode %><br>
            <%= @order.bill_address.country.name %><br>
            📞 <%= @order.bill_address.phone %>
          </div>
          <div class="edit-mode" style="display: flex; flex-direction: column; gap: 0.5rem; font-size: 0.85rem;">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
              <div>
                <label style="font-weight: 600; display: block; margin-bottom: 0.15rem;">First Name</label>
                <input type="text" name="order[bill_address_attributes][firstname]" value="<%= @order.bill_address.firstname %>" form="editOrderForm" class="form-control" style="width: 100%; padding: 0.25rem; font-size: 0.85rem; background-color: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-sm);">
              </div>
              <div>
                <label style="font-weight: 600; display: block; margin-bottom: 0.15rem;">Last Name</label>
                <input type="text" name="order[bill_address_attributes][lastname]" value="<%= @order.bill_address.lastname %>" form="editOrderForm" class="form-control" style="width: 100%; padding: 0.25rem; font-size: 0.85rem; background-color: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-sm);">
              </div>
            </div>
            <div>
              <label style="font-weight: 600; display: block; margin-bottom: 0.15rem;">Address line 1</label>
              <input type="text" name="order[bill_address_attributes][address1]" value="<%= @order.bill_address.address1 %>" form="editOrderForm" class="form-control" style="width: 100%; padding: 0.25rem; font-size: 0.85rem; background-color: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-sm);">
            </div>
            <div>
              <label style="font-weight: 600; display: block; margin-bottom: 0.15rem;">Address line 2</label>
              <input type="text" name="order[bill_address_attributes][address2]" value="<%= @order.bill_address.address2 %>" form="editOrderForm" class="form-control" style="width: 100%; padding: 0.25rem; font-size: 0.85rem; background-color: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-sm);">
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
              <div>
                <label style="font-weight: 600; display: block; margin-bottom: 0.15rem;">City</label>
                <input type="text" name="order[bill_address_attributes][city]" value="<%= @order.bill_address.city %>" form="editOrderForm" class="form-control" style="width: 100%; padding: 0.25rem; font-size: 0.85rem; background-color: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-sm);">
              </div>
              <div>
                <label style="font-weight: 600; display: block; margin-bottom: 0.15rem;">State</label>
                <input type="text" name="order[bill_address_attributes][state_name]" value="<%= @order.bill_address.state_name || @order.bill_address.state&.name %>" form="editOrderForm" class="form-control" style="width: 100%; padding: 0.25rem; font-size: 0.85rem; background-color: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-sm);">
              </div>
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
              <div>
                <label style="font-weight: 600; display: block; margin-bottom: 0.15rem;">Zip Code</label>
                <input type="text" name="order[bill_address_attributes][zipcode]" value="<%= @order.bill_address.zipcode %>" form="editOrderForm" class="form-control" style="width: 100%; padding: 0.25rem; font-size: 0.85rem; background-color: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-sm);">
              </div>
              <div>
                <label style="font-weight: 600; display: block; margin-bottom: 0.15rem;">Phone</label>
                <input type="text" name="order[bill_address_attributes][phone]" value="<%= @order.bill_address.phone %>" form="editOrderForm" class="form-control" style="width: 100%; padding: 0.25rem; font-size: 0.85rem; background-color: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-sm);">
              </div>
            </div>
          </div>
        <% else %>
          <div class="view-mode" style="color: var(--text-muted); font-size: 0.85rem;">No billing address</div>
          <div class="edit-mode" style="color: var(--text-muted); font-size: 0.85rem;">Cannot edit (billing address record does not exist)</div>
        <% end %>
      </div>

      <!-- Shipping Address -->
      <div class="card" style="padding: 1.5rem; background-color: white; height: auto; flex-shrink: 0;">
        <h3 style="font-size: 1rem; font-weight: 600; margin-bottom: 0.75rem; color: var(--secondary); border-bottom: 1px solid var(--border); padding-bottom: 0.25rem;">Shipping Address</h3>
        <% if @order.ship_address %>
          <div class="view-mode" style="font-size: 0.85rem; color: #475569; line-height: 1.5;">
            <strong><%= @order.ship_address.full_name %></strong><br>
            <%= @order.ship_address.address1 %><br>
            <% if @order.ship_address.address2.present? %>
              <%= @order.ship_address.address2 %><br>
            <% end %>
            <%= @order.ship_address.city %>, <%= @order.ship_address.state&.name || @order.ship_address.state_name %> <%= @order.ship_address.zipcode %><br>
            <%= @order.ship_address.country.name %><br>
            📞 <%= @order.ship_address.phone %>
          </div>
          <div class="edit-mode" style="display: flex; flex-direction: column; gap: 0.5rem; font-size: 0.85rem;">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
              <div>
                <label style="font-weight: 600; display: block; margin-bottom: 0.15rem;">First Name</label>
                <input type="text" name="order[ship_address_attributes][firstname]" value="<%= @order.ship_address.firstname %>" form="editOrderForm" class="form-control" style="width: 100%; padding: 0.25rem; font-size: 0.85rem; background-color: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-sm);">
              </div>
              <div>
                <label style="font-weight: 600; display: block; margin-bottom: 0.15rem;">Last Name</label>
                <input type="text" name="order[ship_address_attributes][lastname]" value="<%= @order.ship_address.lastname %>" form="editOrderForm" class="form-control" style="width: 100%; padding: 0.25rem; font-size: 0.85rem; background-color: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-sm);">
              </div>
            </div>
            <div>
              <label style="font-weight: 600; display: block; margin-bottom: 0.15rem;">Address line 1</label>
              <input type="text" name="order[ship_address_attributes][address1]" value="<%= @order.ship_address.address1 %>" form="editOrderForm" class="form-control" style="width: 100%; padding: 0.25rem; font-size: 0.85rem; background-color: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-sm);">
            </div>
            <div>
              <label style="font-weight: 600; display: block; margin-bottom: 0.15rem;">Address line 2</label>
              <input type="text" name="order[ship_address_attributes][address2]" value="<%= @order.ship_address.address2 %>" form="editOrderForm" class="form-control" style="width: 100%; padding: 0.25rem; font-size: 0.85rem; background-color: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-sm);">
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
              <div>
                <label style="font-weight: 600; display: block; margin-bottom: 0.15rem;">City</label>
                <input type="text" name="order[ship_address_attributes][city]" value="<%= @order.ship_address.city %>" form="editOrderForm" class="form-control" style="width: 100%; padding: 0.25rem; font-size: 0.85rem; background-color: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-sm);">
              </div>
              <div>
                <label style="font-weight: 600; display: block; margin-bottom: 0.15rem;">State</label>
                <input type="text" name="order[ship_address_attributes][state_name]" value="<%= @order.ship_address.state_name || @order.ship_address.state&.name %>" form="editOrderForm" class="form-control" style="width: 100%; padding: 0.25rem; font-size: 0.85rem; background-color: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-sm);">
              </div>
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
              <div>
                <label style="font-weight: 600; display: block; margin-bottom: 0.15rem;">Zip Code</label>
                <input type="text" name="order[ship_address_attributes][zipcode]" value="<%= @order.ship_address.zipcode %>" form="editOrderForm" class="form-control" style="width: 100%; padding: 0.25rem; font-size: 0.85rem; background-color: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-sm);">
              </div>
              <div>
                <label style="font-weight: 600; display: block; margin-bottom: 0.15rem;">Phone</label>
                <input type="text" name="order[ship_address_attributes][phone]" value="<%= @order.ship_address.phone %>" form="editOrderForm" class="form-control" style="width: 100%; padding: 0.25rem; font-size: 0.85rem; background-color: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-sm);">
              </div>
            </div>
          </div>
        <% else %>
          <div class="view-mode" style="color: var(--text-muted); font-size: 0.85rem;">No shipping address</div>
          <div class="edit-mode" style="color: var(--text-muted); font-size: 0.85rem;">Cannot edit (shipping address record does not exist)</div>
        <% end %>
      </div>

      <!-- Booking Attribution -->
      <div class="card" style="padding: 1.5rem; background-color: white; height: auto; flex-shrink: 0;">
        <h3 style="font-size: 1rem; font-weight: 600; margin-bottom: 0.75rem; color: var(--secondary); border-bottom: 1px solid var(--border); padding-bottom: 0.25rem;">🎯 Booking Attribution</h3>
        <div style="font-size: 0.85rem; color: #475569; line-height: 1.6; display: flex; flex-direction: column; gap: 0.5rem;">
          <div>
            <strong style="color: var(--secondary);">Source:</strong> 
            <span style="font-weight: 600; color: var(--primary);"><%= @order.booking_source.presence || "Direct / Unknown" %></span>
          </div>
          <% if @order.utm_source.present? || @order.utm_medium.present? || @order.utm_campaign.present? %>
            <div style="background-color: #f8fafc; border: 1px solid var(--border); padding: 0.5rem; border-radius: var(--radius-sm); margin-top: 0.25rem;">
              <div style="font-weight: 600; color: var(--secondary); margin-bottom: 0.25rem; font-size: 0.8rem; text-transform: uppercase;">UTM Parameters</div>
              <div style="font-family: monospace; font-size: 0.75rem; display: flex; flex-direction: column; gap: 0.15rem;">
                <div><strong>source:</strong> <%= @order.utm_source || "-" %></div>
                <div><strong>medium:</strong> <%= @order.utm_medium || "-" %></div>
                <div><strong>campaign:</strong> <%= @order.utm_campaign || "-" %></div>
                <div><strong>term:</strong> <%= @order.utm_term || "-" %></div>
                <div><strong>content:</strong> <%= @order.utm_content || "-" %></div>
              </div>
            </div>
          <% end %>
          <div>
            <strong style="color: var(--secondary);">Landing Page:</strong><br>
            <span style="font-family: monospace; font-size: 0.75rem; word-break: break-all; color: var(--text-muted);"><%= @order.landing_page.presence || "-" %></span>
          </div>
          <div>
            <strong style="color: var(--secondary);">Referrer:</strong><br>
            <span style="font-family: monospace; font-size: 0.75rem; word-break: break-all; color: var(--text-muted);"><%= @order.referrer.presence || "-" %></span>
          </div>
          <div>
            <strong style="color: var(--secondary);">First Visit Date:</strong> 
            <span style="color: var(--text-main);"><%= @order.first_visit_at&.strftime("%B %d, %Y at %I:%M %p") || "-" %></span>
          </div>
          <div style="border-top: 1px solid var(--border); margin-top: 0.25rem; padding-top: 0.5rem; font-size: 0.8rem; color: var(--text-muted); display: flex; flex-direction: column; gap: 0.25rem;">
            <div><strong>IP:</strong> <%= @order.ip_address.presence || "-" %></div>
            <div><strong>Location:</strong> <%= [@order.attribution_country, @order.attribution_state, @order.attribution_city].reject(&:blank?).join(", ").presence || "Unknown" %></div>
            <div><strong>Browser / OS:</strong> <%= @order.browser || "Unknown" %> / <%= @order.operating_system || "Unknown" %></div>
            <div><strong>Device:</strong> <%= @order.device_type || "Unknown" %></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div style="display: flex; justify-content: flex-start; border-top: 1px solid var(--border); padding-top: 1.5rem;">
  <a href="/admin_custom/orders" class="btn btn-outline">&larr; Back to Orders List</a>
</div>

<!-- Declaring the HTML5 Form to process updates without nesting -->
<%= form_tag admin_custom_order_path(@order.number), method: :patch, id: "editOrderForm" %>
</form>

<script>
  function setEditMode(editing) {
    const container = document.getElementById('orderContainer');
    if (editing) {
      container.classList.add('editing');
    } else {
      container.classList.remove('editing');
    }
  }
</script>
