<script>
  function updateVariantDetails(selectEl) {
    const selectedOption = selectEl.options[selectEl.selectedIndex];
    const price = selectedOption.getAttribute('data-price');
    const mrp = selectedOption.getAttribute('data-mrp');
    const savings = selectedOption.getAttribute('data-savings');
    
    const priceDisplay = document.getElementById('product-price-display');
    const mrpDisplay = document.getElementById('product-mrp-display');
    const savingsDisplay = document.getElementById('product-savings-display');
    
    if (priceDisplay && price) priceDisplay.innerText = price;
    if (mrpDisplay && mrp) mrpDisplay.innerText = mrp;
    if (savingsDisplay && savings) {
      savingsDisplay.innerText = savings;
      if (savings.includes("Karnataka")) {
        priceDisplay.style.color = '#16a34a';
        savingsDisplay.style.color = '#15803d';
        savingsDisplay.style.background = '#dcfce7';
        savingsDisplay.style.borderColor = '#86efac';
      } else {
        priceDisplay.style.color = '#15803d';
        savingsDisplay.style.color = '#15803d';
        savingsDisplay.style.background = '#dcfce7';
        savingsDisplay.style.borderColor = '#86efac';
      }
    }
    
    const inStock = selectedOption.getAttribute('data-in-stock') === '1';
    const ebBtn = document.getElementById('easy-booking-btn');
    const bnBtn = document.getElementById('buy-now-btn');
    const stickyButtons = document.querySelectorAll('#sticky-mobile-cta button');
    
    if (ebBtn) {
      if (inStock) ebBtn.removeAttribute('disabled');
      else ebBtn.setAttribute('disabled', 'disabled');
    }
    if (bnBtn) {
      if (inStock) bnBtn.removeAttribute('disabled');
      else bnBtn.setAttribute('disabled', 'disabled');
    }
    stickyButtons.forEach(btn => {
      if (inStock) btn.removeAttribute('disabled');
      else btn.setAttribute('disabled', 'disabled');
    });
  }

  function triggerStickyCTA(isEasyBooking) {
    const form = document.getElementById('add-to-cart-form');
    if (form) {
      if (form.getAttribute('data-submitted') === 'true') return;
      
      let checkoutInput = form.querySelector('input[name="checkout"]');
      if (!checkoutInput) {
        checkoutInput = document.createElement('input');
        checkoutInput.type = 'hidden';
        checkoutInput.name = 'checkout';
        form.appendChild(checkoutInput);
      }
      checkoutInput.value = '1';

      let buyNowInput = form.querySelector('input[name="buy_now"]');
      if (!buyNowInput) {
        buyNowInput = document.createElement('input');
        buyNowInput.type = 'hidden';
        buyNowInput.name = 'buy_now';
        form.appendChild(buyNowInput);
      }
      buyNowInput.value = isEasyBooking ? '0' : '1';
      
      // Update sticky cta text
      const stickyButtons = document.querySelectorAll('#sticky-mobile-cta button');
      stickyButtons.forEach(btn => {
        btn.style.opacity = '0.7';
        btn.style.cursor = 'not-allowed';
        btn.innerHTML = '🔄 Processing...';
      });

      if (typeof form.requestSubmit === 'function') {
        form.requestSubmit();
      } else {
        form.setAttribute('data-submitted', 'true');
        form.submit();
      }
    }
  }

  // Collapsible description toggle
  function toggleDescription() {
    const container = document.getElementById('cro-description-container');
    const fade = document.getElementById('cro-desc-fade');
    const btn = document.getElementById('cro-desc-toggle');
    if (!container || !btn) return;

    if (container.style.maxHeight === '110px' || container.style.maxHeight === '') {
      container.style.maxHeight = '2000px';
      if (fade) fade.style.display = 'none';
      btn.innerText = 'Read Less';
    } else {
      container.style.maxHeight = '110px';
      if (fade) fade.style.display = 'block';
      btn.innerText = 'Read More';
    }
  }

  // Single-Open FAQ Accordion handler
  function toggleSingleFaq(headerEl) {
    const item = headerEl.parentElement;
    const body = item.querySelector('.cro-faq-body');
    const arrow = item.querySelector('.faq-arrow');
    const allItems = document.querySelectorAll('.cro-faq-item');

    allItems.forEach(function(otherItem) {
      if (otherItem !== item) {
        const otherBody = otherItem.querySelector('.cro-faq-body');
        const otherArrow = otherItem.querySelector('.faq-arrow');
        if (otherBody) otherBody.style.maxHeight = '0';
        if (otherArrow) otherArrow.style.transform = 'rotate(0deg)';
      }
    });

    if (body.style.maxHeight === '0px' || body.style.maxHeight === '') {
      body.style.maxHeight = body.scrollHeight + 'px';
      if (arrow) arrow.style.transform = 'rotate(180deg)';
    } else {
      body.style.maxHeight = '0';
      if (arrow) arrow.style.transform = 'rotate(0deg)';
    }
  }

  // Sticky Mobile CTA and WhatsApp Widget Setup
  document.addEventListener('DOMContentLoaded', function() {
    if (window.location.pathname.includes('/checkout')) {
      const stickyBar = document.getElementById('sticky-mobile-cta');
      const waBtn = document.getElementById('floating-whatsapp-btn');
      if (stickyBar) stickyBar.style.display = 'none';
      if (waBtn) waBtn.style.display = 'none';
      return;
    }

    // Sticky bar scroll trigger for mobile viewports
    window.addEventListener('scroll', function() {
      if (window.innerWidth < 768) {
        const stickyBar = document.getElementById('sticky-mobile-cta');
        const waBtn = document.getElementById('floating-whatsapp-btn');
        const footer = document.querySelector('footer');
        
        if (stickyBar) {
          let showBar = window.scrollY > 120;
          
          // Hide sticky bar when footer is in view
          if (footer) {
            const footerRect = footer.getBoundingClientRect();
            if (footerRect.top <= window.innerHeight) {
              showBar = false;
            }
          }
          
          if (showBar) {
            stickyBar.style.display = 'block';
            document.body.style.paddingBottom = '65px';
            if (waBtn) waBtn.style.setProperty('bottom', '80px', 'important');
          } else {
            stickyBar.style.display = 'none';
            document.body.style.paddingBottom = '0';
            if (waBtn) waBtn.style.setProperty('bottom', '20px', 'important');
          }
        }
      }
    }, { passive: true });
  });

  // --- Gallery Swapping and Autoplay Logic ---
  let currentImageIndex = 0;
  let autoplayTimer = null;
  const autoplayDelay = 4000;

  window.swapImage = function(thumbEl, url) {
    const mainImg = document.getElementById('main-product-media');
    if (!mainImg) return;
    
    mainImg.style.transition = 'opacity 0.15s ease';
    mainImg.style.opacity = '0.3';
    
    setTimeout(() => {
      mainImg.src = url;
      mainImg.style.opacity = '1';
    }, 150);

    const thumbnails = document.querySelectorAll('.gallery-thumb');
    thumbnails.forEach(t => {
      t.classList.remove('active');
    });
    
    if (thumbEl) {
      thumbEl.classList.add('active');
    }

    if (window.galleryImages) {
      const idx = window.galleryImages.indexOf(url);
      if (idx !== -1) {
        currentImageIndex = idx;
        const dots = document.querySelectorAll('.gallery-dot');
        dots.forEach((dot, dIdx) => {
          if (dIdx === idx) {
            dot.style.background = '#15803d';
            dot.style.width = '12px';
            dot.style.borderRadius = '4px';
          } else {
            dot.style.background = 'rgba(0,0,0,0.25)';
            dot.style.width = '8px';
            dot.style.borderRadius = '50%';
          }
        });
      }
    }

    resetAutoplay();
  };

  window.openLightbox = function(src) {
    let lightbox = document.getElementById('product-lightbox');
    if (!lightbox) {
      lightbox = document.createElement('div');
      lightbox.id = 'product-lightbox';
      lightbox.style.cssText = 'position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.85); display:flex; align-items:center; justify-content:center; z-index:10000; opacity:0; transition:opacity 0.25s ease; cursor:zoom-out; backdrop-filter:blur(5px);';
      
      const img = document.createElement('img');
      img.id = 'lightbox-img';
      img.style.cssText = 'max-width:90%; max-height:90%; object-fit:contain; border-radius:8px; box-shadow:0 10px 25px rgba(0,0,0,0.3);';
      lightbox.appendChild(img);
      
      const closeBtn = document.createElement('span');
      closeBtn.innerHTML = '&times;';
      closeBtn.style.cssText = 'position:absolute; top:20px; right:30px; font-size:40px; color:#fff; cursor:pointer; font-weight:bold;';
      lightbox.appendChild(closeBtn);
      
      lightbox.addEventListener('click', function() {
        lightbox.style.opacity = '0';
        setTimeout(() => lightbox.style.display = 'none', 250);
      });
      
      document.body.appendChild(lightbox);
    }
    
    const img = lightbox.querySelector('#lightbox-img');
    img.src = src;
    lightbox.style.display = 'flex';
    lightbox.offsetHeight;
    lightbox.style.opacity = '1';
  };

  function startAutoplay() {
    if (!window.galleryImages || window.galleryImages.length <= 1) return;
    autoplayTimer = setInterval(() => {
      currentImageIndex = (currentImageIndex + 1) % window.galleryImages.length;
      const nextUrl = window.galleryImages[currentImageIndex];
      
      const thumbnails = document.querySelectorAll('.gallery-thumb');
      let targetThumb = null;
      
      thumbnails.forEach(t => {
        const img = t.querySelector('img');
        if (img && img.getAttribute('src') === nextUrl) {
          targetThumb = t;
        }
      });
      
      if (targetThumb) {
        const container = targetThumb.parentElement;
        if (container) {
          const containerRect = container.getBoundingClientRect();
          const thumbRect = targetThumb.getBoundingClientRect();
          const leftOffset = container.scrollLeft + (thumbRect.left - containerRect.left) - (containerRect.width - thumbRect.width) / 2;
          container.scrollTo({ left: leftOffset, behavior: 'smooth' });
        }
      }
      
      window.swapImage(targetThumb, nextUrl);
    }, autoplayDelay);
  }

  function resetAutoplay() {
    if (autoplayTimer) {
      clearInterval(autoplayTimer);
    }
    startAutoplay();
  }

  // Touch Swipe Gesture Support for Mobile
  document.addEventListener('DOMContentLoaded', function() {
    const mainImg = document.getElementById('main-product-media');
    if (mainImg) {
      let touchstartX = 0;
      let touchendX = 0;
      
      mainImg.addEventListener('touchstart', e => {
        touchstartX = e.changedTouches[0].screenX;
      }, { passive: true });
      
      mainImg.addEventListener('touchend', e => {
        touchendX = e.changedTouches[0].screenX;
        handleGesture();
      }, { passive: true });
      
      function handleGesture() {
        if (!window.galleryImages || window.galleryImages.length <= 1) return;
        const threshold = 50; // swipe distance threshold in px
        if (touchendX < touchstartX - threshold) {
          // Swipe Left -> Next Image
          currentImageIndex = (currentImageIndex + 1) % window.galleryImages.length;
          triggerImageSwap(currentImageIndex);
        }
        if (touchendX > touchstartX + threshold) {
          // Swipe Right -> Previous Image
          currentImageIndex = (currentImageIndex - 1 + window.galleryImages.length) % window.galleryImages.length;
          triggerImageSwap(currentImageIndex);
        }
      }
      
      function triggerImageSwap(idx) {
        const nextUrl = window.galleryImages[idx];
        const thumbnails = document.querySelectorAll('.gallery-thumb');
        let targetThumb = null;
        thumbnails.forEach(t => {
          const img = t.querySelector('img');
          if (img && img.getAttribute('src') === nextUrl) {
            targetThumb = t;
          }
        });
        
        if (targetThumb) {
          const container = targetThumb.parentElement;
          if (container) {
            const containerRect = container.getBoundingClientRect();
            const thumbRect = targetThumb.getBoundingClientRect();
            const leftOffset = container.scrollLeft + (thumbRect.left - containerRect.left) - (containerRect.width - thumbRect.width) / 2;
            container.scrollTo({ left: leftOffset, behavior: 'smooth' });
          }
        }
        window.swapImage(targetThumb, nextUrl);
      }
    }
  });

  // Start autoplay on load
  startAutoplay();

  // Support Turbo navigation page loads
  document.addEventListener('turbo:load', () => {
    resetAutoplay();
  });
</script>
