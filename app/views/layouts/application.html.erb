    <!-- Global CRO Event Tracking -->
    <script>
      // Define global tracking helper
      window.trackFunnelEventInternal = function(eventName, productId) {
        const data = new FormData();
        data.append('event_name', eventName);
        if (productId) data.append('product_id', productId);
        data.append('path', window.location.pathname);
        if (navigator.sendBeacon) {
          navigator.sendBeacon('/api/track_event', data);
        } else {
          fetch('/api/track_event', {
            method: 'POST',
            body: data
          }).catch(function(){});
        }
      };

      document.addEventListener('turbo:load', function() {
        // Track page views
        const path = window.location.pathname;
        let productId = null;
        
        // Try to locate product ID on product page
        if (path.startsWith('/products/')) {
          const mainForm = document.getElementById('add-to-cart-form') || document.querySelector('form[action*="/cart/add"]');
          if (mainForm) {
            productId = mainForm.getAttribute('data-product-id') || mainForm.querySelector('input[name="product_id"]')?.value;
          }
          trackCroEvent('Product View', { product_slug: path.split('/').pop() });
        } else if (path === '/') {
          trackCroEvent('Homepage View');
        } else if (path === '/checkout/address') {
          trackCroEvent('Checkout Started');
        } else if (path.startsWith('/orders/show') || path.includes('/orders/')) {
          trackCroEvent('Order Completed');
        }

        // Track clicks on Easy Booking and Buy Now buttons
        document.querySelectorAll('button, input[type="submit"], a, .btn-cro-primary, .btn-primary').forEach(function(btn) {
          const txt = (btn.textContent || btn.value || '').trim().toUpperCase();
          if (txt.includes('EASY BOOKING') || txt.includes('BOOKING') || txt.includes('BUY NOW')) {
            btn.addEventListener('click', function() {
              if (btn.getAttribute('data-tracked') === 'true') return;
              btn.setAttribute('data-tracked', 'true');
              setTimeout(function() { btn.removeAttribute('data-tracked'); }, 1000);

              let currentProductId = btn.getAttribute('data-product-id') || productId;
              if (!currentProductId) {
                const form = btn.closest('form');
                if (form) {
                  currentProductId = form.getAttribute('data-product-id') || form.querySelector('input[name="product_id"]')?.value;
                }
              }

              // Distinguish Easy Booking and Buy Now clicks
              if (txt.includes('BUY NOW')) {
                trackCroEvent('Buy Now Click', { product_id: currentProductId });
                window.trackFunnelEventInternal('click_buy_now', currentProductId);
              } else {
                trackCroEvent('Easy Booking Click', { product_id: currentProductId });
                window.trackFunnelEventInternal('click_easy_booking', currentProductId);
              }
            });
          }
        });

        // Track clicks on Offer Banner
        document.querySelectorAll('.cro-offer-card, .offer-banner').forEach(function(el) {
          el.addEventListener('click', function() {
            trackCroEvent('Offer Banner Click', { product_id: productId });
            window.trackFunnelEventInternal('click_offer_banner', productId);
          });
        });

        // Track CTA Impressions and Review Section Viewed via IntersectionObserver
        if (typeof IntersectionObserver !== 'undefined') {
          // 1. Observe CTA Container
          const ctaTarget = document.getElementById('add-to-cart-form') || document.querySelector('.product-detail-info');
          if (ctaTarget) {
            let ctaTracked = false;
            const ctaObserver = new IntersectionObserver(function(entries) {
              entries.forEach(function(entry) {
                if (entry.isIntersecting && !ctaTracked) {
                  ctaTracked = true;
                  trackCroEvent('CTA Impression', { product_id: productId });
                  window.trackFunnelEventInternal('cta_impression', productId);
                  ctaObserver.unobserve(entry.target);
                }
              });
            }, { threshold: 0.1 });
            ctaObserver.observe(ctaTarget);
          }

          // 2. Observe Reviews Section
          const reviewsTarget = document.getElementById('reviews-section');
          if (reviewsTarget) {
            let reviewsTracked = false;
            const reviewsObserver = new IntersectionObserver(function(entries) {
              entries.forEach(function(entry) {
                if (entry.isIntersecting && !reviewsTracked) {
                  reviewsTracked = true;
                  trackCroEvent('Review Section Viewed', { product_id: productId });
                  window.trackFunnelEventInternal('view_reviews_section', productId);
                  reviewsObserver.unobserve(entry.target);
                }
              });
            }, { threshold: 0.1 });
            reviewsObserver.observe(reviewsTarget);
          }
        }

        // Scroll depth tracking
        let scrollDepths = { 25: false, 50: false, 75: false, 100: false };
        function scrollDepthHandler() {
          const scrollTop = window.scrollY || window.pageYOffset || document.documentElement.scrollTop;
          const docHeight = document.documentElement.scrollHeight - window.innerHeight;
          if (docHeight <= 0) return;
          const pct = Math.round((scrollTop / docHeight) * 100);
          [25, 50, 75, 100].forEach(function(depth) {
            if (pct >= depth && !scrollDepths[depth]) {
              scrollDepths[depth] = true;
              trackCroEvent('Scroll Depth ' + depth + '%', { product_id: productId });
              window.trackFunnelEventInternal('scroll_depth_' + depth, productId);
            }
          });
        }
        window.addEventListener('scroll', scrollDepthHandler, { passive: true });

        // Cleanup listener on next navigation to prevent leaks
        document.addEventListener('turbo:before-visit', function cleanup() {
          window.removeEventListener('scroll', scrollDepthHandler);
          document.removeEventListener('turbo:before-visit', cleanup);
        });

        // Track clicks on WhatsApp elements
        document.querySelectorAll('a[href*="wa.me"], .btn-whatsapp-chat, #floating-whatsapp-btn').forEach(function(el) {
          el.addEventListener('click', function() {
            trackCroEvent('WhatsApp Click');
          });
        });

        // Track clicks on Call elements
        document.querySelectorAll('a[href^="tel:"]').forEach(function(el) {
          el.addEventListener('click', function() {
            trackCroEvent('Call Click');
          });
        });

        // Prevent double form submissions on add-to-cart actions
        document.querySelectorAll('form[action*="/cart/add"]').forEach(function(form) {
          form.addEventListener('submit', function(e) {
            if (form.getAttribute('data-submitted') === 'true') {
              e.preventDefault();
              return false;
            }
            form.setAttribute('data-submitted', 'true');
            
            const submitBtn = form.querySelector('button[type="submit"], input[type="submit"]');
            if (submitBtn) {
              submitBtn.style.opacity = '0.7';
              submitBtn.style.cursor = 'not-allowed';
              if (!submitBtn.innerHTML.includes('Processing')) {
                submitBtn.innerHTML = '🔄 Processing...';
              }
            }
          });
        });
      });

      function trackCroEvent(eventName, params) {
        console.log('[CRO Analytics] Event:', eventName, params);
        
        // 1. Send to Google Analytics (gtag)
        if (typeof gtag !== 'undefined') {
          gtag('event', eventName.toLowerCase().replace(/ /g, '_'), params || {});
        }
        
        // 2. Send to Meta Pixel (fbq)
        if (typeof fbq !== 'undefined') {
          fbq('trackCustom', eventName, params || {});
        }
      }
    </script>
