<% content_for :title, "Product Catalog - Jeeni Shop" %>

<!-- Breadcrumbs -->
<div style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 1.5rem;">
  <a href="/">Home</a> / <span style="color: var(--text-main); font-weight: 500;">Catalog</span>
</div>

<div class="catalog-layout" style="grid-template-columns: 1fr;">

  <!-- Product Grid Section -->
  <section>
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
      <h2 style="font-size: 1.5rem; font-weight: 700; color: var(--secondary);">
        <%= params[:query].present? ? "Search Results for '#{params[:query]}'" : "All Products" %>
        <span style="font-size: 0.875rem; font-weight: 400; color: var(--text-muted); margin-left: 0.5rem;">(<%= @products.total_count %> found)</span>
      </h2>
      <% if spree_current_user&.has_spree_role?("admin") %>
        <div>
          <a href="/admin_custom/products/new" class="btn btn-primary btn-sm">➕ Create New Product</a>
        </div>
      <% end %>
    </div>

    <% if @products.any? %>
      <div class="grid grid-cols-3">
        <% @products.each do |product| %>
          <div class="card <%= priority_product?(product) ? 'priority-product-card' : '' %>">
            <div class="card-img-wrapper" style="position: relative; overflow: hidden; background: #f1f5f9; height: 180px;">
              <% if priority_product?(product) %>
                <% if product.slug == 'jeeni-slim-new' %>
                  <span class="priority-badge priority-badge-best-seller">Slim & Active</span>
                <% elsif product.slug == 'jeeni-sugaramla-1kg-sugaramla-1kg' %>
                  <span class="priority-badge priority-badge-best-seller">Sugar Balance</span>
                <% elsif product.name.to_s.downcase.include?('health mix') %>
                  <span class="priority-badge priority-badge-best-seller">Best Seller</span>
                <% else %>
                  <span class="priority-badge">Featured</span>
                <% end %>
              <% elsif product.featured? %>
                <span class="card-badge">Featured</span>
              <% end %>
              <%= render_product_media(product) %>
            </div>
            
            <div class="card-content">
              <h3 class="card-title" style="font-size: 1.1rem;"><a href="/products/<%= product.slug %>"><%= product.name %></a></h3>
              <p style="font-size: 0.75rem; color: var(--text-muted); margin-bottom: 0.5rem;">
                📍 <%= [product.district, product.state].compact.reject(&:empty?).join(', ') %>
              </p>
              <p class="card-description"><%= truncate(product.description, length: 70) %></p>
              
              <div class="card-footer" style="display: flex; flex-direction: column; gap: 0.75rem; margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--border);">
                <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                  <% if karnataka_visitor? && product.karnataka_price.present? %>
                    <div style="display: flex; flex-direction: column; gap: 0.15rem; align-items: flex-start; text-align: left;">
                      <span style="font-size: 0.75rem; color: #16a34a; font-weight: 700; display: inline-flex; align-items: center; gap: 0.25rem;">🏷️ Karnataka Special Price</span>
                      <span class="card-price" style="font-size: 1.4rem; font-weight: 900; color: #16a34a;">₹<%= product.karnataka_price.to_i %></span>
                      <span style="font-size: 0.85rem; color: #94a3b8; text-decoration: line-through; font-weight: 500;">₹<%= product.price.to_i %></span>
                    </div>
                  <% else %>
                    <span class="card-price"><%= product.display_price.to_s %></span>
                  <% end %>
                </div>
                
                <% if priority_product?(product) %>
                  <!-- Easy Booking (Full Width) -->
                  <%= form_tag add_to_cart_path, method: :post, style: "width: 100%; display: flex; flex-direction: column; gap: 0.5rem; margin: 0;" do %>
                    <input type="hidden" name="variant_id" value="<%= product.master.id %>">
                    <input type="hidden" name="checkout" value="1">
                    <button type="submit" class="btn" style="width: 100%; justify-content: center; background: #b12704; color: white; font-weight: 800; border: none; border-radius: var(--radius-md); padding: 0.75rem; font-size: 0.95rem; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.5rem; box-shadow: 0 4px 12px rgba(177, 39, 4, 0.25);">
                      ⚡ BUY NOW (Cash on Delivery)
                    </button>
                  <% end %>
                  
                  <!-- Row for Add to Cart and View Details -->
                  <div style="display: flex; gap: 0.5rem; width: 100%;">
                    <%= form_tag add_to_cart_path, method: :post, style: "flex: 1; margin: 0;" do %>
                      <input type="hidden" name="variant_id" value="<%= product.master.id %>">
                      <button type="submit" class="btn btn-outline" style="width: 100%; justify-content: center; font-size: 0.85rem; padding: 0.5rem; min-height: 38px; border-color: var(--border); color: var(--text-main); display: inline-flex; align-items: center; gap: 0.25rem;">
                        🛒 Add
                      </button>
                    <% end %>
                    <a href="/products/<%= product.slug %>" class="btn btn-outline" style="flex: 1; justify-content: center; font-size: 0.85rem; padding: 0.5rem; min-height: 38px; border-color: var(--border); color: var(--text-main); display: inline-flex; align-items: center; justify-content: center;">
                      Details
                    </a>
                  </div>
                <% else %>
                  <!-- Row for Add to Cart and View Details (for standard products) -->
                  <div style="display: flex; gap: 0.5rem; width: 100%;">
                    <%= form_tag add_to_cart_path, method: :post, style: "flex: 1; margin: 0;" do %>
                      <input type="hidden" name="variant_id" value="<%= product.master.id %>">
                      <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center; font-size: 0.85rem; padding: 0.5rem; min-height: 38px; background: linear-gradient(135deg, #15803d, #166534); border: none; color: white; display: inline-flex; align-items: center; gap: 0.25rem; border-radius: var(--radius-md);">
                        🛒 Add
                      </button>
                    <% end %>
                    <a href="/products/<%= product.slug %>" class="btn btn-outline" style="flex: 1; justify-content: center; font-size: 0.85rem; padding: 0.5rem; min-height: 38px; border-color: var(--border); color: var(--text-main); display: inline-flex; align-items: center; justify-content: center; border-radius: var(--radius-md);">
                      Details
                    </a>
                  </div>
                <% end %>

                <% if spree_current_user&.has_spree_role?("admin") %>
                  <div style="display: flex; gap: 0.5rem; justify-content: space-between; width: 100%; margin-top: 0.5rem;">
                    <a href="/admin_custom/products/<%= product.slug %>/edit" class="btn btn-secondary btn-sm" style="flex: 1;">✏️ Edit</a>
                    <%= button_to admin_custom_product_path(product), method: :delete, class: "btn btn-outline btn-sm", style: "flex: 1; border-color: #fee2e2; color: var(--danger);", data: { confirm: "Delete this product?" } do %>
                      🗑️ Delete
                    <% end %>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
      
      <!-- Pagination -->
      <div style="margin-top: 3rem; display: flex; justify-content: center;">
        <%= paginate @products %>
      </div>
    <% else %>
      <div style="text-align: center; padding: 5rem 2rem; background: white; border: 1px solid var(--border); border-radius: var(--radius-md);">
        <span style="font-size: 3rem; display: block; margin-bottom: 1rem;">🔍</span>
        <h3 style="font-size: 1.5rem; font-weight: 700; color: var(--secondary); margin-bottom: 0.5rem;">No Products Found</h3>
        <p style="color: var(--text-muted); margin-bottom: 1.5rem;">Try adjusting your filter criteria or search keyword.</p>
        <a href="/products" class="btn btn-primary">Reset Filters</a>
      </div>
    <% end %>
  </section>
</div>
