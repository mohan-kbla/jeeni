  <!-- FEATURE 4 (cont.): Explore More Healthy Products Section -->
  <section class="home-section-other-products" style="margin-bottom: 4rem;">
    <div style="text-align: center; margin-bottom: 3rem; padding: 0 1rem;">
      <h2 style="font-size: 2.25rem; font-weight: 800; color: #0f172a; margin-bottom: 0.5rem; letter-spacing: -0.025em; font-family: 'Outfit', 'Inter', sans-serif;">
        🌾 Explore More Healthy Millet Products
      </h2>
      <p style="font-size: 1.1rem; color: #475569; max-width: 600px; margin: 0 auto; line-height: 1.6; font-family: 'Inter', sans-serif;">
        Discover delicious and nutritious choices for your everyday wellness.
      </p>
    </div>
    
    <div class="premium-showcase-grid">
      <% if @other_products.present? && @other_products.any? %>
        <% @other_products.each do |product| %>
          <% 
            badge_text = nil
            badge_class = nil
            
            if product.discount_info.present?
              badge_text = product.discount_info
              badge_class = "premium-showcase-badge-offer"
            elsif karnataka_visitor? && product.karnataka_price.present?
              badge_text = "Special Offer"
              badge_class = "premium-showcase-badge-offer"
            elsif product.featured?
              badge_text = "Popular"
              badge_class = "premium-showcase-badge-popular"
            elsif product.created_at > 30.days.ago
              badge_text = "New"
              badge_class = "premium-showcase-badge-new"
            end
          %>
          
          <%
            video_markup = nil
            if product.respond_to?(:product_gallery) && product.product_gallery.present?
              gallery = product.product_gallery
              v = gallery.gallery_videos.find_by(is_featured: true) || gallery.gallery_videos.order(position: :asc).first
              if v
                if v.file.attached?
                  video_url = Rails.application.routes.url_helpers.rails_blob_path(v.file, only_path: true)
                  video_markup = "<video src='#{video_url}' autoplay muted loop playsinline class='premium-showcase-video' style='width: 100%; height: 100%; object-fit: contain; position: absolute; top: 0; left: 0; z-index: 1;'></video>".html_safe
                elsif v.youtube_embed_url.present?
                  embed_url = v.youtube_embed_url
                  if embed_url.include?('youtube.com/embed/')
                    separator = embed_url.include?('?') ? '&' : '?'
                    playlist_param = embed_url.split('/embed/')[1]
                    embed_url = "#{embed_url}#{separator}autoplay=1&mute=1&loop=1&controls=0&playlist=#{playlist_param}"
                  end
                  video_markup = "<iframe src='#{embed_url}' class='premium-showcase-video' style='width: 100%; height: 100%; border: none; object-fit: contain; position: absolute; top: 0; left: 0; z-index: 1;' allow='autoplay; encrypted-media' loading='lazy'></iframe>".html_safe
                end
              end
            end
          %>
          
          <a href="/products/<%= product.slug %>" class="premium-showcase-card">
            <div class="premium-showcase-image-wrapper">
              <% if badge_text %>
                <span class="premium-showcase-badge <%= badge_class %>">
                  <%= badge_text %>
                </span>
              <% end %>
              <img src="<%= product_image_url(product) %>" class="premium-showcase-image" alt="<%= product.name %>" loading="lazy">
              <% if video_markup.present? %>
                <%= video_markup %>
              <% end %>
            </div>
            <div class="premium-showcase-content">
              <span class="cert-badge" style="background: #f0fdf4; color: #166534; border: 1px solid #bbf7d0; width: fit-content; margin-bottom: 0.5rem; font-size: 0.72rem; font-weight: 700; text-transform: uppercase;">Traditional Wholesome</span>
              <h3 class="premium-showcase-card-title"><%= product.name %></h3>
              <p class="premium-showcase-description"><%= truncate(product.description, length: 85) %></p>
              
              <div class="premium-showcase-footer">
                <div class="premium-showcase-price-box">
                  <span class="premium-showcase-price-label">Price</span>
                  <% if karnataka_visitor? && product.karnataka_price.present? %>
                    <span class="premium-showcase-price premium-showcase-price-special">₹<%= product.karnataka_price.to_i %></span>
                    <span class="premium-showcase-price-old">₹<%= product.price.to_i %></span>
                  <% else %>
                    <span class="premium-showcase-price">₹<%= product.price.to_i %></span>
                  <% end %>
                </div>
                <div class="premium-showcase-cta">
                  Shop Now <span style="font-size: 1.1rem; line-height: 1;">→</span>
                </div>
              </div>
            </div>
          </a>
        <% end %>
      <% end %>
    </div>
  </section>



  <!-- Step-by-Step Preparation Method -->
  <section class="prep-container home-section-prep" style="margin-bottom: 4rem;">
    <div class="section-title-wrap" style="margin-bottom: 1.5rem;">
      <h2 class="section-title-main">Easy Preparation Method</h2>
      <p class="section-title-sub">Cook a healthy warm drink in 10 minutes</p>
    </div>
    
    <div class="prep-grid">
      <div class="prep-step">
        <div class="prep-number">1</div>
        <div class="prep-title">Measure Portion</div>
        <div class="prep-desc">Add 1½ tablespoons (15g) of Jeeni mix.</div>
      </div>
      <div class="prep-step">
        <div class="prep-number">2</div>
        <div class="prep-title">Mix with Water</div>
        <div class="prep-desc">Pour 250ml of clean water and mix well.</div>
      </div>
      <div class="prep-step">
        <div class="prep-number">3</div>
        <div class="prep-title">Stir to Smooth</div>
        <div class="prep-desc">Mix thoroughly to completely avoid any lumps.</div>
      </div>
      <div class="prep-step">
        <div class="prep-number">4</div>
        <div class="prep-title">Cook on Low Flame</div>
        <div class="prep-desc">Boil for 7–10 minutes while stirring continuously.</div>
      </div>
      <div class="prep-step">
        <div class="prep-number">5</div>
        <div class="prep-title">Add Flavor & Serve</div>
        <div class="prep-desc">Add jaggery, salt, or buttermilk as preferred. Serve warm!</div>
      </div>
    </div>
  </section>
</div>

