<% content_for :title, "Orders Management - Admin" %>

<style>
  .dispatched-order {
    background-color: #f3f4f6 !important;
  }
  .dispatched-order td {
    background-color: #f3f4f6 !important;
    color: #4b5563 !important;
  }
  .dispatched-order td.order-number-td {
    color: #1f2937 !important;
  }
  .dispatched-order td.order-total-td {
    color: #b12704 !important; /* var(--primary) */
  }
  .ready-to-ship-order {
    background-color: #e6f4ea !important; /* light green */
  }
  .ready-to-ship-order td {
    background-color: #e6f4ea !important;
  }
</style>

<div style="margin-bottom: 2rem;">
  <h1 style="font-size: 2rem; font-weight: 700; color: var(--secondary);">Orders Fulfillment</h1>
  <p style="color: var(--text-muted);">Monitor purchase transactions, capture payments, and manage logistics shipments.</p>
</div>

<!-- Order Filters Form -->
<%
  from_date_val = params[:from_date].present? ? (Time.zone.parse(params[:from_date]).strftime('%Y-%m-%dT%H:%M') rescue params[:from_date]) : nil
  to_date_val = params[:to_date].present? ? (Time.zone.parse(params[:to_date]).strftime('%Y-%m-%dT%H:%M') rescue params[:to_date]) : nil
%>
<form method="get" action="/admin_custom/orders" class="filters-form" id="filtersForm">
  <input type="hidden" name="date_filter" id="dateFilterInput" value="<%= params[:date_filter] %>">
  
  <div class="filters-container" style="display: flex; flex-wrap: wrap; gap: 1.25rem; align-items: center; justify-content: space-between; margin-bottom: 2rem; background: var(--bg-main); padding: 1.25rem; border-radius: var(--radius-md); border: 1px solid var(--border); box-shadow: var(--shadow-sm);">
    <!-- Left Side: Quick Filters Segmented Control -->
    <div style="display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;">
      <span style="font-weight: 600; color: var(--secondary); font-size: 0.95rem; display: flex; align-items: center; gap: 0.25rem;">
        🔍 Quick Filters:
      </span>
      <div style="display: flex; gap: 0.35rem; background: var(--bg-card); padding: 0.25rem; border-radius: var(--radius-sm); border: 1px solid var(--border);">
        <a href="#" onclick="setQuickFilter(''); return false;" class="btn <%= params[:date_filter].blank? && params[:from_date].blank? && params[:to_date].blank? ? 'btn-primary' : 'btn-outline' %> btn-sm" style="padding: 0.35rem 0.75rem; font-size: 0.8rem; border-radius: var(--radius-sm); border: none; font-weight: 500;">All</a>
        <a href="#" onclick="setQuickFilter('today'); return false;" class="btn <%= params[:date_filter] == 'today' ? 'btn-primary' : 'btn-outline' %> btn-sm" style="padding: 0.35rem 0.75rem; font-size: 0.8rem; border-radius: var(--radius-sm); border: none; font-weight: 500;">Today</a>
        <a href="#" onclick="setQuickFilter('yesterday'); return false;" class="btn <%= params[:date_filter] == 'yesterday' ? 'btn-primary' : 'btn-outline' %> btn-sm" style="padding: 0.35rem 0.75rem; font-size: 0.8rem; border-radius: var(--radius-sm); border: none; font-weight: 500;">Yesterday</a>
      </div>
    </div>

    <!-- Middle: Product Filter -->
    <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
      <span style="font-weight: 600; color: var(--secondary); font-size: 0.95rem; display: flex; align-items: center; gap: 0.25rem;">
        📦 Product:
      </span>
      <%= select_tag :product_id, options_from_collection_for_select(@products, :id, :name, params[:product_id]), include_blank: "All Products", class: "form-control", onchange: "this.form.submit();", style: "width: auto; padding: 0.35rem 0.5rem; font-size: 0.85rem; border-radius: var(--radius-sm); border: 1px solid var(--border); height: auto; background-color: var(--bg-card);" %>
    </div>

    <!-- Customer Name Search -->
    <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
      <span style="font-weight: 600; color: var(--secondary); font-size: 0.95rem; display: flex; align-items: center; gap: 0.25rem;">
        👤 Customer:
      </span>
      <input type="text" name="customer_name" value="<%= params[:customer_name] %>" placeholder="Name" class="form-control" style="width: 140px; padding: 0.35rem 0.5rem; font-size: 0.85rem; border-radius: var(--radius-sm); border: 1px solid var(--border); height: auto; background-color: var(--bg-card);">
    </div>

    <!-- Phone Number Search -->
    <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
      <span style="font-weight: 600; color: var(--secondary); font-size: 0.95rem; display: flex; align-items: center; gap: 0.25rem;">
        📞 Phone:
      </span>
      <input type="text" name="phone_number" value="<%= params[:phone_number] %>" placeholder="Phone" class="form-control" style="width: 130px; padding: 0.35rem 0.5rem; font-size: 0.85rem; border-radius: var(--radius-sm); border: 1px solid var(--border); height: auto; background-color: var(--bg-card);">
    </div>

    <!-- Right Side: Custom Date Range Form Controls -->
    <div style="display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;">
      <span style="font-weight: 600; color: var(--secondary); font-size: 0.95rem; display: flex; align-items: center; gap: 0.25rem;">
        📅 Custom Range:
      </span>
      <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
        <div style="display: flex; align-items: center; gap: 0.35rem;">
          <span style="font-size: 0.8rem; color: var(--text-muted); font-weight: 500;">From</span>
          <input type="datetime-local" id="from_date" name="from_date" value="<%= from_date_val %>" class="form-control" style="width: auto; padding: 0.35rem 0.5rem; font-size: 0.85rem; border-radius: var(--radius-sm); border: 1px solid var(--border); height: auto; background-color: var(--bg-card);">
        </div>
        <div style="display: flex; align-items: center; gap: 0.35rem;">
          <span style="font-size: 0.8rem; color: var(--text-muted); font-weight: 500;">To</span>
          <input type="datetime-local" id="to_date" name="to_date" value="<%= to_date_val %>" class="form-control" style="width: auto; padding: 0.35rem 0.5rem; font-size: 0.85rem; border-radius: var(--radius-sm); border: 1px solid var(--border); height: auto; background-color: var(--bg-card);">
        </div>
        <button type="submit" class="btn btn-primary btn-sm" onclick="document.getElementById('dateFilterInput').value='custom';" style="padding: 0.35rem 0.75rem; font-size: 0.8rem; font-weight: 600; height: auto;">Apply</button>
      </div>
    </div>
  </div>
</form>

<script>
  function setQuickFilter(val) {
    document.getElementById('dateFilterInput').value = val;
    if (val !== 'custom') {
      document.getElementById('from_date').value = '';
      document.getElementById('to_date').value = '';
    }
    document.getElementById('filtersForm').submit();
  }
</script>

<% if @orders.any? %>
  <div class="table-responsive">
    <table class="table">
      <thead>
        <tr>
          <th style="width: 35%;">Shipping Address</th>
          <th style="width: 30%;">Order Items</th>
          <th style="width: 20%;">Order Status</th>
          <th style="width: 15%;">Order Details</th>
        </tr>
      </thead>
      <tbody>
        <% @orders.each do |order| %>
          <% 
            row_class = if order.state == 'dispatched'
                          'dispatched-order'
                        elsif order.payment_state == 'paid' && order.shipment_state == 'ready'
                          'ready-to-ship-order'
                        else
                          ''
                        end
          %>
          <tr class="order-row <%= row_class %>" data-order-id="<%= order.number %>">
            <!-- 1st Column: Shipping Address -->
            <td>
              <% if order.ship_address %>
                <div style="line-height: 1.5;">
                  <strong style="font-size: 1rem; color: var(--secondary);"><%= order.ship_address.full_name %></strong><br>
                  <span style="font-size: 0.9rem;"><%= order.ship_address.address1 %></span><br>
                  <% if order.ship_address.address2.present? %>
                    <span style="font-size: 0.9rem;"><%= order.ship_address.address2 %></span><br>
                  <% end %>
                  <span style="font-size: 0.9rem;"><%= order.ship_address.city %>, <%= order.ship_address.state&.name || order.ship_address.state_name %> - <%= order.ship_address.zipcode %></span><br>
                  Phone: <strong style="color: var(--secondary);"><%= order.ship_address.phone %></strong>
                </div>
              <% else %>
                <span style="color: var(--text-muted);">No shipping address</span>
              <% end %>
            </td>

            <!-- 2nd Column: Order Items -->
            <td>
              <% order.line_items.each do |item| %>
                <div style="margin-bottom: 0.75rem; border-bottom: 1px dashed var(--border); padding-bottom: 0.5rem;">
                  <div style="font-weight: 600; color: var(--secondary);"><%= item.variant.product.name %></div>
                  <% if item.variant.options_text.present? %>
                    <div style="font-size: 0.8rem; color: var(--text-muted);"><%= item.variant.options_text %></div>
                  <% end %>
                  <div style="margin-top: 0.25rem; font-size: 0.85rem; display: flex; gap: 0.5rem; align-items: center;">
                    <span class="badge badge-info" style="font-size: 0.75rem; padding: 0.15rem 0.4rem;">Qty: <%= item.quantity %></span>
                    <span style="color: var(--text-muted);">SKU: <%= item.variant.sku %></span>
                  </div>
                </div>
              <% end %>
            </td>

            <!-- 3rd Column: Order Status (with update facility) -->
            <td>
              <div style="display: flex; flex-direction: column; gap: 0.5rem; align-items: flex-start;">
                <% state_class = case order.state
                   when 'complete' then 'badge-success'
                   when 'dispatched' then 'badge-success'
                   when 'canceled' then 'badge-danger'
                   when 'returned' then 'badge-danger'
                   else 'badge-warning'
                   end %>
                <span class="badge <%= state_class %> order-state-badge" data-order-id="<%= order.number %>" style="min-width: 100px; text-align: center; font-size: 0.85rem; padding: 0.35rem 0.5rem;">
                  <%= order.state&.titleize || 'Pending' %>
                </span>
                
                <% unless spree_current_user.respond_to?(:read_only_orders?) && spree_current_user.read_only_orders? %>
                  <select name="status" class="form-control status-select" data-order-id="<%= order.number %>" style="width: 100%; max-width: 150px; padding: 0.25rem 0.5rem; font-size: 0.8rem; height: auto;">
                    <% [
                      ['Cart', 'cart'],
                      ['Address', 'address'],
                      ['Delivery', 'delivery'],
                      ['Payment', 'payment'],
                      ['Confirm', 'confirm'],
                      ['Payment Confirm', 'payment_confirm'],
                      ['Complete', 'complete'],
                      ['Canceled', 'canceled'],
                      ['Awaiting Return', 'awaiting_return'],
                      ['Returned', 'returned'],
                      ['Resumed', 'resumed'],
                      ['Dispatched', 'dispatched'],
                      ['Out for Delivery', 'out_for_delivery'],
                      ['Delivered', 'delivered']
                    ].each do |label, value| %>
                      <option value="<%= value %>" <%= 'selected' if order.state == value %>><%= label %></option>
                    <% end %>
                  </select>
                  <button type="button" class="btn btn-primary btn-sm update-status-btn" data-order-id="<%= order.number %>" style="padding: 0.25rem 0.5rem; font-size: 0.8rem; font-weight: 500; width: 100%; max-width: 150px; text-align: center;">Update Status</button>
                <% end %>
              </div>
            </td>

            <!-- 4th Column: Order Number / Details -->
            <td class="order-number-td" style="line-height: 1.6;">
              <a href="/admin_custom/orders/<%= order.number %>" style="font-weight: 700; color: var(--primary); text-decoration: underline; font-size: 1.1rem; display: block; margin-bottom: 0.25rem;"><%= order.number %></a>
              <span style="font-size: 0.8rem; color: var(--text-muted); display: block;"><%= order.completed_at&.strftime("%b %d, %Y at %I:%M %p") %></span>
              <span style="font-weight: 700; color: #b12704; display: block; margin-top: 0.25rem; font-size: 1rem;"><%= (order.display_total rescue nil) || "₹#{'%.2f' % order.total}" %></span>
              
              <div style="margin-top: 0.5rem; display: flex; flex-direction: column; gap: 0.25rem;">
                <div>
                  <small style="color: var(--text-muted);">Payment:</small>
                  <% pay_class = case order.payment_state
                     when 'paid' then 'badge-success'
                     when 'void' then 'badge-danger'
                     when 'failed' then 'badge-danger'
                     else 'badge-warning'
                     end %>
                  <span class="badge <%= pay_class %>" style="font-size: 0.75rem; padding: 0.1rem 0.3rem;"><%= order.payment_state&.titleize || 'Pending' %></span>
                </div>
                <div>
                  <small style="color: var(--text-muted);">Shipment:</small>
                  <% ship_class = case order.shipment_state
                     when 'shipped' then 'badge-success'
                     when 'ready' then 'badge-info'
                     when 'backorder' then 'badge-warning'
                     else 'badge-danger'
                     end %>
                  <span class="badge <%= ship_class %>" style="font-size: 0.75rem; padding: 0.1rem 0.3rem;"><%= order.shipment_state&.titleize || 'Pending' %></span>
                </div>
              </div>
              
              <a href="/admin_custom/orders/<%= order.number %>" class="btn btn-outline btn-sm" style="margin-top: 0.75rem; display: inline-block; padding: 0.25rem 0.5rem; font-size: 0.8rem; font-weight: 500;">Show</a>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  
  <div style="display: flex; justify-content: center; margin-top: 2rem;">
    <%= paginate @orders %>
  </div>
  
  <!-- AJAX Update Script -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const updateButtons = document.querySelectorAll('.update-status-btn');
      
      updateButtons.forEach(button => {
        button.addEventListener('click', function(e) {
          e.preventDefault();
          
          const orderId = this.getAttribute('data-order-id');
          const selectElement = document.querySelector(`.status-select[data-order-id="${orderId}"]`);
          const newStatus = selectElement.value;
          
          button.disabled = true;
          button.innerText = 'Saving...';
          
          const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
          
          fetch(`/admin_custom/orders/${orderId}/update_status`, {
            method: 'PATCH',
            headers: {
              'Content-Type': 'application/json',
              'X-CSRF-Token': csrfToken,
              'Accept': 'application/json'
            },
            body: JSON.stringify({ state: newStatus })
          })
          .then(response => response.json())
          .then(data => {
            button.disabled = false;
            button.innerText = 'Update Status';
            
            if (data.success) {
              showFlashMessage('notice', `Order #${orderId} status successfully updated to ${data.new_state}.`);
              
              const badge = document.querySelector(`.order-state-badge[data-order-id="${orderId}"]`);
              if (badge) {
                badge.className = `badge order-state-badge ${getStateBadgeClass(data.new_state)}`;
                badge.innerText = capitalizeWords(data.new_state.replace(/_/g, ' '));
              }
              
              const row = document.querySelector(`tr[data-order-id="${orderId}"]`);
              if (row) {
                if (data.new_state === 'dispatched') {
                  row.classList.add('dispatched-order');
                } else {
                  row.classList.remove('dispatched-order');
                }
              }
            } else {
              showFlashMessage('alert', `Error updating order #${orderId}: ${data.error}`);
            }
          })
          .catch(error => {
            button.disabled = false;
            button.innerText = 'Update Status';
            showFlashMessage('alert', `Connection error: ${error.message}`);
          });
        });
      });
      
      function showFlashMessage(type, message) {
        const oldFlash = document.getElementById('ajax-flash-notice');
        if (oldFlash) oldFlash.remove();
        
        const flashDiv = document.createElement('div');
        flashDiv.id = 'ajax-flash-notice';
        flashDiv.className = `alert alert-${type}`;
        flashDiv.style.marginBottom = '2rem';
        
        flashDiv.innerHTML = `
          <span>${message}</span>
          <button onclick="this.parentElement.remove();" style="background: none; border: none; font-size: 1.2rem; cursor: pointer; color: inherit; font-weight: bold;">&times;</button>
        `;
        
        const container = document.querySelector('.admin-content');
        const topbar = container.firstElementChild;
        container.insertBefore(flashDiv, topbar.nextSibling);
        
        setTimeout(() => {
          if (document.getElementById('ajax-flash-notice') === flashDiv) {
            flashDiv.remove();
          }
        }, 5000);
      }
      
      function capitalizeWords(str) {
        return str.split(' ').map(w => w.charAt(0).toUpperCase() + w.substring(1)).join(' ');
      }
      
      function getStateBadgeClass(state) {
        switch (state) {
          case 'complete': return 'badge-success';
          case 'dispatched': return 'badge-success';
          case 'canceled': return 'badge-danger';
          case 'returned': return 'badge-danger';
          default: return 'badge-warning';
        }
      }
    });
  </script>
<% else %>
  <div style="text-align: center; padding: 5rem 2rem; background: white; border: 1px solid var(--border); border-radius: var(--radius-md);">
    <span style="font-size: 3rem; display: block; margin-bottom: 1rem;">🛒</span>
    <h3 style="font-size: 1.25rem; font-weight: 700; color: var(--secondary); margin-bottom: 0.5rem;">No Orders Found</h3>
    <p style="color: var(--text-muted);">No sales matching the filters have been recorded.</p>
  </div>
<% end %>
